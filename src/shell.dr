// Shell integration: the few lines a shell is given so the window knows
// where each prompt is, what command was run, when it started and how it
// ended -- what makes a terminal's history into blocks, and what lets the
// assistant learn from what a person actually does.
//
// The marks are the ones every modern terminal reads (FinalTerm's OSC 133,
// as VS Code, kitty, WezTerm and iTerm2 do): `A` where the prompt starts,
// `B` where it ends and typing begins, `C` where the command's output
// starts, `D;status` when it has finished. VS Code's `OSC 633;E` carries the
// command line itself, so it need not be read back off the screen, and
// `OSC 7` the working directory.
//
// **The person's own configuration is loaded first, untouched**, and the
// integration added after it: bash is started with `--rcfile` pointing at a
// file that sources `~/.bashrc` and then hooks `PROMPT_COMMAND` and `PS0`;
// zsh with `ZDOTDIR` pointing at a directory whose files source the real
// ones from the person's own `ZDOTDIR` and then add `precmd` and `preexec`
// hooks; fish with `--init-command` sourcing a file that does the same with
// its `fish_prompt`, `fish_preexec` and `fish_postexec` events. A shell this
// does not know -- nushell, a plain `sh` -- runs as it is, and the terminal
// works without blocks.
import std.cli;
import std.file;
import std.list;
import std.os;
import std.path;
import std.str;

/// The kinds of shell integration is written for.
union Kind { bash, zsh, fish, other }

/// Which kind of shell a program is, by its name.
let kind_of : :string -> Kind;
let kind_of program = match path.basename program {
    "bash" => Kind.bash,
    "zsh" => Kind.zsh,
    "fish" => Kind.fish,
    _ => Kind.other,
};

/// The bash side: run after `~/.bashrc`, in the person's shell.
let bashrc : :string;
let bashrc = "# sleep: shell integration for bash. Your own ~/.bashrc is read first.
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f \"$HOME/.bashrc\" ] && . \"$HOME/.bashrc\"
if [ -z \"$__sleep_installed\" ]; then
__sleep_installed=1
__sleep_esc() { local c=\"$1\"; c=\"${c//\\\\/\\\\\\\\}\"; c=\"${c//;/\\\\x3b}\"; c=\"${c//$'\\n'/\\\\x0a}\"; c=\"${c//$'\\a'/}\"; c=\"${c//$'\\e'/}\"; printf '%s' \"$c\"; }
__sleep_prompt() {
  local s=$?
  printf '\\033]133;D;%s\\007' \"$s\"
  printf '\\033]7;file://%s%s\\007\\033]133;A\\007' \"${HOSTNAME:-localhost}\" \"$PWD\"
  return $s
}
__sleep_ps1() { case \"$PS1\" in *'133;B'*) ;; *) PS1=\"$PS1\"'\\[\\033]133;B\\007\\]' ;; esac; }
__sleep_pre() {
  local c; c=$(HISTTIMEFORMAT= builtin history 1 | sed 's/^ *[0-9]* *//')
  printf '\\033]633;E;%s\\007\\033]133;C\\007' \"$(__sleep_esc \"$c\")\"
}
PROMPT_COMMAND=\"__sleep_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND};__sleep_ps1\"
PS0='$(__sleep_pre)'
fi
";

/// The zsh side: `.zshrc` in the integration's own `ZDOTDIR`.
let zshrc : :string;
let zshrc = "# sleep: shell integration for zsh. Your own .zshrc is read first.
ZDOTDIR=\"${SLEEP_USER_ZDOTDIR:-$HOME}\"
[ -f \"$ZDOTDIR/.zshrc\" ] && . \"$ZDOTDIR/.zshrc\"
if [ -z \"$__sleep_installed\" ]; then
__sleep_installed=1
autoload -Uz add-zsh-hook
__sleep_ran=0
__sleep_precmd() {
  local s=$?
  if [[ $__sleep_ran == 1 ]]; then print -n \"\\e]133;D;$s\\a\"; __sleep_ran=0; fi
  print -n \"\\e]7;file://${HOST:-localhost}$PWD\\a\\e]133;A\\a\"
  # $'..', not \"..\": zsh's double quotes and its prompt expansion leave
  # \\e as two characters, which the prompt then shows.
  [[ $PS1 == *'133;B'* ]] || PS1=\"$PS1%{\"$'\\e]133;B\\a'\"%}\"
}
__sleep_preexec() {
  __sleep_ran=1
  local c=\"${1//\\\\/\\\\\\\\}\"; c=\"${c//;/\\\\x3b}\"; c=\"${c//$'\\n'/\\\\x0a}\"
  print -rn -- $'\\e]633;E;'\"$c\"$'\\a\\e]133;C\\a'
}
add-zsh-hook precmd __sleep_precmd
add-zsh-hook preexec __sleep_preexec
fi
";

/// The fish side: sourced by `--init-command`, after the person's config.
let fish : :string;
let fish = "# sleep: shell integration for fish, sourced after your own config.
if not set -q __sleep_installed
    set -g __sleep_installed 1
    function __sleep_prompt --on-event fish_prompt
        printf '\\e]7;file://%s%s\\a\\e]133;A\\a' (prompt_hostname) \"$PWD\"
    end
    function __sleep_preexec --on-event fish_preexec
        set -l c (string replace -a '\\\\' '\\\\\\\\' -- $argv[1] | string replace -a ';' '\\x3b' | string join '\\x0a')
        printf '\\e]633;E;%s\\a\\e]133;C\\a' \"$c\"
    end
    function __sleep_postexec --on-event fish_postexec
        printf '\\e]133;D;%s\\a' $status
    end
    # The end of the prompt, where typing begins: after the person's own
    # fish_prompt, whichever it is.
    functions -q fish_prompt; and functions -c fish_prompt __sleep_user_prompt
    function fish_prompt
        functions -q __sleep_user_prompt; and __sleep_user_prompt
        printf '\\e]133;B\\a'
    end
end
";

/// The other files of zsh's startup, each passing on to the person's own.
priv let zsh_passthrough name = "ZDOTDIR=\"${SLEEP_USER_ZDOTDIR:-$HOME}\"\n[ -f \"$ZDOTDIR/" + name
    + "\" ] && . \"$ZDOTDIR/" + name + "\"\nZDOTDIR=\"" + "$SLEEP_ZDOTDIR\"\n";

/// Where the integration's files are kept: the person's cache.
let directory! : :unit -> :string;
let directory! u = {
    let cache = match os.env! "XDG_CACHE_HOME" {
        () => path.join (match path.home! () { () => "/tmp", h => h }) ".cache",
        "" => path.join (match path.home! () { () => "/tmp", h => h }) ".cache",
        d => d,
    };
    path.join (path.join cache "sleep") "shell"
};

/// Write the integration's files, and answer how to start `program` with them:
/// `[args, env]` to add to its own.
let prepare! : :string -> [[:string]];
let prepare! program = {
    let dir = directory! ();
    match kind_of program {
        Kind.bash => {
            file.mkdir_all! dir
            let rc = path.join dir "bashrc";
            file.write! rc bashrc
            [["--rcfile", rc, "-i"], []]
        },
        Kind.zsh => {
            let z = path.join dir "zsh";
            file.mkdir_all! z
            file.write! (path.join z ".zshrc") zshrc
            file.write! (path.join z ".zshenv") (zsh_passthrough ".zshenv")
            file.write! (path.join z ".zprofile") (zsh_passthrough ".zprofile")
            file.write! (path.join z ".zlogin") (zsh_passthrough ".zlogin")
            let own = match os.env! "ZDOTDIR" { () => "", d => d };
            [["-i"], ["ZDOTDIR=" + z, "SLEEP_ZDOTDIR=" + z, "SLEEP_USER_ZDOTDIR=" + own]]
        },
        Kind.fish => {
            file.mkdir_all! dir
            let rc = path.join dir "sleep.fish";
            file.write! rc fish
            [["-i", "--init-command", "source " + cli.shell_word rc], []]
        },
        Kind.other => [[], []],
    }
};

when test {
    import std.pty;
    import std.test;
    let units = [
        test.case "shells are known by their names" $(test.eq! [Kind.bash, Kind.zsh, Kind.fish, Kind.other]
            [kind_of "/usr/bin/bash", kind_of "zsh", kind_of "/usr/bin/fish", kind_of "nu"]),
        test.case "the integration marks a prompt, a command and its end" $({
            test.true! (str.contains_str "133;A" bashrc && str.contains_str "133;C" bashrc && str.contains_str "133;D" bashrc)
            test.true! (str.contains_str "add-zsh-hook preexec" zshrc)
            test.true! (str.contains_str "fish_postexec" fish)
        }),
    ];

    // Each shell this machine has, run as sleep runs it -- the integration
    // prepared, on a terminal of its own -- in an empty home, so nobody's
    // own configuration is in it, given a command and then `exit`. Every mark
    // must arrive as an escape sequence, and none as text: zsh once showed
    // `\e]133;B\a` at the end of every prompt, and a test that only read
    // these strings could not see it.
    let run_shell! = fn program -> {
        let home = file.temp_dir! ();
        let [args, env] = prepare! program;
        let p = pty.spawn! (pty.Options.new () |> pty.Options.set_program program |> pty.Options.set_args args
            |> pty.Options.set_env (list.append env ["HOME=" + home, "TERM=xterm-256color"])
            |> pty.Options.set_dir home);
        pty.write! p "echo hi\r"
        pty.write! p "exit\r"
        let out = pty.read_all! p;
        strict! out
        file.remove_all! home
        out
    };
    let marks_test = fn name -> test.case (name + ", where installed, marks every prompt and command and shows none of them") $(
        match path.find_program! name {
            () => test.true! true,
            program => {
                let out = run_shell! program;
                test.true! (list.all (fn m -> str.contains_str ("\u{1b}]133;" + m) out) ["A", "B", "C", "D;0"])
                test.false! (str.contains_str "\\e]133" out || str.contains_str "\\033]133" out || str.contains_str "133;B\\a" out)
                test.true! (str.contains_str "hi" out)
            },
        });
    let shells = list.map marks_test ["bash", "zsh", "fish"];
    let tests = list.append units shells;
}
