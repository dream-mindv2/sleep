// The terminal: what a program's output does to a screen.
//
// A program on a terminal writes text and escape sequences -- move the
// cursor, colour what follows, clear a line, scroll a region, switch to the
// alternate screen -- and this is the machine that obeys them: the screen as
// a grid of cells, the cursor, the pen they are written with, and the modes
// a program can set. It speaks the xterm dialect `TERM=xterm-256color`
// promises, as far as the programs people run use it: 16, 256 and 24-bit
// colour, scroll regions, insert and delete, the alternate screen (vim, less,
// htop), DEC line drawing (tmux's borders), bracketed paste, application
// cursor keys, the replies a program asks for (where is the cursor, what are
// you), and the operating-system commands a shell sends -- the title, the
// working directory (OSC 7), and the marks of shell integration (OSC 133),
// which is what lets the window know where a command began and how it ended.
//
// **It is pure.** `feed term bytes` answers the next terminal; what the
// program must be told back (`replies`) and what happened that the window
// cares about (`events`) are fields of it, taken by whoever drives it. So the
// whole of it is tested here by feeding it text, with no terminal in sight.
//
// **Lines are numbered from the start of the session**, not from the top of
// the screen: line `n` stays line `n` as it scrolls up into the history, so
// a scroll of the whole screen changes one line -- the new one at the bottom
// -- and that is all a window drawing it has to be told. `dirty` is the set
// of line numbers changed since `take_updates` last asked.
//
// **A row is its runs**: the text written on it, a run per style, the
// rightmost first, and nothing for the blank cells past the last one
// written. A program writes a line left to right, so writing is a cons or one
// run made longer, and a row is drawn by naming its runs, not by walking its
// cells. A style is one integer (`pen`): eight bits of flags, then the
// foreground and background, each `0` for the terminal's own, `1 + n` for
// palette colour `n`, or `2^24 + rgb`.
//
// **Input arrives in pieces** that may end in the middle of a sequence or of
// a UTF-8 character. What cannot be finished is kept (`pending`) and read
// again in front of the next piece, so the parser itself never has to be in
// the middle of anything.
import std.char;
import std.list;
import std.map;
import std.num;
import std.str;
import std.trunk;
import std.http.url;

// --- styles ------------------------------------------------------------------------

/// Bits of a style's flags, the same as `std.graphics.widgets`' spans.
let bold : :integer;
let bold = 1;
let dim : :integer;
let dim = 2;
let italic : :integer;
let italic = 4;
let underline : :integer;
let underline = 8;
let inverse : :integer;
let inverse = 16;
let strike : :integer;
let strike = 32;
let blink : :integer;
let blink = 64;
let hidden : :integer;
let hidden = 128;

priv let fg_unit = 256;
priv let bg_unit = 8589934592;
priv let colour_span = 33554432;

let flags_of : :integer -> :integer;
let flags_of s = s % 256;
let fg_of : :integer -> :integer;
let fg_of s = (s / fg_unit) % colour_span;
let bg_of : :integer -> :integer;
let bg_of s = s / bg_unit;
let pen : :integer -> :integer -> :integer -> :integer;
let pen flags fg bg = flags + fg * fg_unit + bg * bg_unit;

priv let with_flag on bit s = if on { if s % (bit * 2) >= bit { s } else { s + bit } }
    else { if s % (bit * 2) >= bit { s - bit } else { s } };
priv let with_fg c s = s - fg_of s * fg_unit + c * fg_unit;
priv let with_bg c s = s - bg_of s * bg_unit + c * bg_unit;

/// A colour as CSS: the 16 of the palette as the theme's variables, so a
/// change of theme recolours them; the 6x6x6 cube and the grey ramp of the
/// 256; and 24-bit colour as written. `""` is the terminal's own.
let css_colour : :integer -> :string;
let css_colour c = if c == 0 { "" } else if c <= 16 { "var(--dw-ansi-" + to_string (c - 1) + ")" }
    else if c <= 256 {
        let n = c - 1;
        if n >= 232 { let g = 8 + 10 * (n - 232); rgb g g g } else {
            let i = n - 16;
            rgb (level (i / 36)) (level ((i / 6) % 6)) (level (i % 6))
        }
    } else { let v = c - 16777216; rgb (v / 65536) ((v / 256) % 256) (v % 256) };

priv let level i = if i == 0 { 0 } else { 55 + 40 * i };
priv let rgb r g b = "#" + num.hex 2 r + num.hex 2 g + num.hex 2 b;

// --- rows ------------------------------------------------------------------------

/// Cells written in one style: `text`, the number of `cells` it covers, and
/// whether each of its characters takes exactly one cell and one byte
/// (`plain`), which lets it be cut by byte position rather than by walking
/// its characters. A wide character is one character covering two cells.
struct Run {
    !text : :string
    !style : :integer
    !cells : :integer
    !plain : :bool
}

/// One line of the screen: the runs of what has been written on it, the
/// rightmost first, covering cells `[0, used)`. Every cell past `used` is a
/// blank in the default style and is not kept, so a short line in a wide
/// window costs its length, and writing at the end of a line -- which is
/// most of what programs do -- is one cons, or one run made longer.
/// `wrapped` says the line went on to the next because it ran out of room,
/// not because of a newline, which is what copying the text back out must
/// know.
struct Row {
    !runs : [Run]
    !used : :integer
    !wrapped : :bool
}

/// The row with nothing written on it.
priv let empty_row = Row.make [] 0 false;

/// `n` spaces in `style`, as a run.
priv let spaces n style = Run.make (str.repeat n " ") style n true;

/// A row of `n` empty cells, in the background of `style`.
let blank : :integer -> :integer -> Row;
let blank n style = {
    let bg = pen 0 0 (bg_of style);
    if bg == 0 { empty_row } else { Row.make [spaces n bg] n false }
};

/// How many cells a character takes, by its code.
priv let width_of c = if wide c { 2 } else { 1 };

/// A run's first `c` cells and the rest, `0 < c < cells`. A wide character
/// cut in half leaves a space on each side, as a terminal draws it.
priv let cut c r = if Run.plain r {
    let t = Run.text r;
    [Run.set_cells c (Run.set_text (str.slice 0 c t) r),
     Run.set_cells (Run.cells r - c) (Run.set_text (str.slice c (str.byte_length t - c) t) r)]
} else {
    let rec go cs at acc = match cs {
        [] => [str.of_chars (list.reverse acc), ""],
        [ch, ..rest] => {
            let w = width_of (char.code ch);
            if at + w <= c { go rest (at + w) (list.cons ch acc) }
            else if at == c { [str.of_chars (list.reverse acc), str.of_chars cs] }
            else { [str.of_chars (list.reverse (list.cons ' ' acc)), " " + str.of_chars rest] }
        },
    };
    let [a, b] = go (str.chars (Run.text r)) 0 [];
    [Run.make a (Run.style r) c false, Run.make b (Run.style r) (Run.cells r - c) false]
};

/// Runs (rightmost first, ending at cell `end`) split at cell `c`: those of
/// `[0, c)`, still rightmost first, and those of `[c, end)`, leftmost first.
priv let rec split_at c end runs right = match runs {
    [] => [[], right],
    [r, ..rest] => {
        let start = end - Run.cells r;
        if start >= c { split_at c start rest (list.cons r right) }
        else if end <= c { [runs, right] }
        else { let [a, b] = cut (c - start) r; [list.cons a rest, list.cons b right] }
    },
};

/// The runs of cells `[0, c)`, rightmost first.
priv let runs_before c r = if c >= Row.used r { Row.runs r } else { list.head (split_at c (Row.used r) (Row.runs r) []) };

/// The runs of cells `[c, used)`, leftmost first.
priv let runs_from c r = list.nth 1 (split_at c (Row.used r) (Row.runs r) []);

/// `run` put after runs kept rightmost first, joined to the last when they
/// share a style.
priv let push_run run runs = match runs {
    [last, ..rest] => if Run.style last == Run.style run {
        list.cons (Run.make (Run.text last + Run.text run) (Run.style run) (Run.cells last + Run.cells run) (Run.plain last && Run.plain run)) rest
    } else { list.cons run runs },
    [] => [run],
};

/// Cells `[x, x + cells)` of a row replaced by `run`. Past the end of what
/// is written, the gap is blanks; otherwise what was there is cut around it.
priv let write_run x run r = if x >= Row.used r { write_end x run r } else { write_over x run r };

/// Past the end of what is written: the gap, if any, then the run.
priv let write_end x run r = {
    let padded = if x > Row.used r { push_run (spaces (x - Row.used r) 0) (Row.runs r) } else { Row.runs r };
    Row.make (push_run run padded) (x + Run.cells run) (Row.wrapped r)
};

/// Over what is written: the runs cut around it.
priv let write_over x run r = {
    let n = Run.cells run;
    let runs = list.fold (fn acc a -> push_run a acc) (push_run run (runs_before x r)) (runs_from (x + n) r);
    Row.make runs (num.max (Row.used r) (x + n)) (Row.wrapped r)
};

/// The row's first `n` cells.
priv let truncate n r = if n >= Row.used r { r } else { Row.make (runs_before n r) n (Row.wrapped r) };

/// `k` cells of `style` pushed in at `x`, what was there moved right and
/// whatever goes past `cols` lost.
priv let insert_run x k style cols r = if x >= Row.used r && style == 0 { r } else {
    let used = Row.used r;
    let after = runs_from x r;
    let before = push_run (spaces k style) (if x > used { push_run (spaces (x - used) 0) (Row.runs r) } else { runs_before x r });
    let runs = list.fold (fn acc a -> push_run a acc) before after;
    truncate cols (Row.make runs (num.max used x + k) (Row.wrapped r))
};

/// The row with cells `[x, x + k)` taken out, what was after them moved
/// left, and `k` cells of `style` coming in at the right margin.
priv let delete_run x k style cols r = {
    let used = Row.used r;
    let moved = if x >= used { r } else {
        let after = runs_from (num.min used (x + k)) r;
        Row.make (list.fold (fn acc a -> push_run a acc) (runs_before x r) after) (x + num.max 0 (used - x - k)) false
    };
    if style == 0 { Row.set_wrapped false moved } else { Row.set_wrapped false (write_run (cols - k) (spaces k style) moved) }
};

/// The text of a row's runs, left to right.
priv let joined r = str.concat_all (list.reverse (list.map Run.text (Row.runs r)));

priv let row_fit n r = truncate n r;

/// A row's text, its trailing blanks dropped.
let row_text : Row -> :string;
let row_text r = str.trim_end (joined r);

/// A row as the spans a window draws: `[text, fg, bg, flags]` for each run of
/// cells in one style, its trailing blank cells left out.
let spans : Row -> [[:any]];
let spans r = match Row.runs r {
    [] => [],
    [last, ..before] => {
        // Trailing spaces with nothing to show -- no colour behind them, not
        // inverse -- say nothing, and cost a node.
        let st = Run.style last;
        let shows = bg_of st != 0 || flags_of st % 32 >= 16;
        let text = if shows { Run.text last } else { str.trim_end (Run.text last) };
        if text == "" { match before { [] => [], [next, ..rest] => joined_spans rest (Run.style next) (Run.text next) [] } }
        else { joined_spans before st text [] }
    },
};

/// Runs, rightmost first, as spans left to right, after a span of `text` in
/// `style`. Neighbours in one style are joined: a run is cut where something
/// was written over it, and the window wants one node per style.
priv let rec joined_spans runs style text out = match runs {
    [] => list.cons (span_of style text) out,
    [run, ..rest] => if Run.style run == style { joined_spans rest style (Run.text run + text) out }
        else { joined_spans rest (Run.style run) (Run.text run) (list.cons (span_of style text) out) },
};

priv let span_of style text = if style == 0 { [text, "", "", 0] } else { [text, css_colour (fg_of style), css_colour (bg_of style), flags_of style] };

/// `n` copies of `x`, as a trunk.
priv let run_of n x = trunk.of (list.replicate n x);

// --- the terminal ----------------------------------------------------------------

/// Where the cursor was saved, and how it was writing (DECSC).
struct Saved {
    x : :integer
    y : :integer
    pen : :integer
    dec : :bool
}

/// What a program sets now and then -- the scroll region, the alternate
/// screen, the modes of the cursor, the keypad and the mouse, the title --
/// and the terminal reads as it goes.
struct Modes {
    !limit : :integer = 5000
    !main : :any = ()
    !alt : :bool = false
    !top : :integer = 0
    !bottom : :integer = 23
    !saved : :any = ()
    !app_cursor : :bool = false
    !app_keypad : :bool = false
    !bracketed : :bool = false
    !autowrap : :bool = true
    !origin : :bool = false
    !insert : :bool = false
    !cursor_visible : :bool = true
    !cursor_shape : :atom = :block
    !mouse : :integer = 0
    !sgr_mouse : :bool = false
    !focus_events : :bool = false
    !dec : :bool = false
    !g1_dec : :bool = false
    !shifted : :bool = false
    !tabs : %{:integer => :bool} = %{}
    !title : :string = ""
    !cwd : :string = ""
}

/// A terminal's state that changes as it writes: the screen, the cursor,
/// the pen, and what has changed since the window last asked. It is copied
/// on every change, so it is kept to what changes often; the modes a program
/// sets now and then are one field of it (`Modes`).
struct Term {
    !cols : :integer = 80
    !rows : :integer = 24
    !grid : :trunk = trunk.empty
    !history : :trunk = trunk.empty
    !first : :integer = 0
    !x : :integer = 0
    !y : :integer = 0
    !wrap_next : :bool = false
    !pen : :integer = 0
    !last : :integer = 32
    !pending : :string = ""
    !replies : [:string] = []
    !events : [:any] = []
    !dirty : %{:integer => :bool} = %{}
    !reset : :bool = false
    !modes : Modes = Modes.new ()
}

/// A mode, read: `mode Modes.alt t`.
priv let mode get t = get (Term.modes t);
/// A mode, set: `set_mode Modes.set_alt true t`.
priv let set_mode setter v t = Term.set_modes (setter v (Term.modes t)) t;

/// What the window shows of the terminal's modes.
let title : Term -> :string;
let title t = mode Modes.title t;
let alt : Term -> :bool;
let alt t = mode Modes.alt t;
let app_cursor : Term -> :bool;
let app_cursor t = mode Modes.app_cursor t;
let bracketed : Term -> :bool;
let bracketed t = mode Modes.bracketed t;
let cursor_visible : Term -> :bool;
let cursor_visible t = mode Modes.cursor_visible t;
let cursor_shape : Term -> :atom;
let cursor_shape t = mode Modes.cursor_shape t;

/// A terminal `cols` by `rows`, empty, keeping `limit` lines of history.
let new : :integer -> :integer -> :integer -> Term;
let new cols rows limit = {
    let b = blank cols 0;
    Term.new () |> Term.set_cols cols |> Term.set_rows rows |> Term.set_grid (run_of rows b) |> Term.set_reset true
        |> Term.set_modes (Modes.new () |> Modes.set_limit limit |> Modes.set_bottom (rows - 1))
};

/// The number of the line at the top of the screen.
let base : Term -> :integer;
let base t = Term.first t + trunk.length (Term.history t);

/// Line `n`, from the history or the screen, or `()` for one gone or not yet there.
let line : Term -> :integer -> :any;
let line t n = {
    let b = base t;
    if n < Term.first t { () } else if n < b { trunk.at (n - Term.first t) (Term.history t) }
    else if n < b + Term.rows t { trunk.at (n - b) (Term.grid t) } else { () }
};

/// Line `n`'s text, `""` for one there is not.
let line_text : Term -> :integer -> :string;
let line_text t n = match line t n { () => "", r => row_text r };

/// The cursor as `[line, column]`.
let cursor : Term -> [:integer];
let cursor t = [base t + Term.y t, Term.x t];

priv let touch y t = Term.set_dirty ((Term.dirty t).[base t + y => true]) t;
priv let touch_all t = list.fold (fn acc y -> touch y acc) t (list.range 0 (Term.rows t));
priv let row_at y t = trunk.at y (Term.grid t);
priv let put_row y r t = touch y (Term.set_grid (trunk.set y r (Term.grid t)) t);
priv let erase_style t = pen 0 0 (bg_of (Term.pen t));
priv let event e t = Term.set_events (list.cons e (Term.events t)) t;
priv let reply s t = Term.set_replies (list.cons s (Term.replies t)) t;

/// What changed since the last time among the last `reach` lines -- the
/// screen and the history just above it -- and the terminal with it
/// forgotten: `[lines, replies, events, reset, t, dropped]`, where `lines` is
/// `[number, spans]` for each changed line, `replies` what to write back to
/// the program and `events` what happened, both oldest first, `reset` that
/// the window should forget every line from the top of the screen down, and
/// `dropped` that a changed line further up than `reach` was left out.
let take_updates : :integer -> Term -> [:any];
let take_updates reach t = {
    // Only the lines a window keeps: a flood of output scrolls thousands of
    // lines through between two frames, and drawing the ones already gone
    // from the window's reach would be most of the work.
    let oldest = base t + Term.rows t - reach;
    let all = map.keys (Term.dirty t);
    let numbers = list.sort (list.filter (fn n -> n >= oldest) all);
    let rec drawn ns = match ns {
        [] => [],
        [n, ..rest] => match line t n { () => drawn rest, r => list.cons [n, spans r] (drawn rest) },
    };
    let lines = drawn numbers;
    [lines, list.reverse (Term.replies t), list.reverse (Term.events t), Term.reset t,
     t |> Term.set_dirty map.empty |> Term.set_replies [] |> Term.set_events [] |> Term.set_reset false,
     len numbers < len all]
};

/// The terminal with its last `n` lines marked changed, those it still has:
/// what a window sent only part of them is sent again whole.
let touch_last : :integer -> Term -> Term;
let touch_last n t = {
    let end = base t + Term.rows t;
    Term.set_dirty (list.fold (fn acc l -> acc.[l => true]) (Term.dirty t) (list.range (num.max (Term.first t) (end - n)) end)) t
};

// --- scrolling -------------------------------------------------------------------

/// A blank row for this terminal, in the current background: the shared one
/// when the background is the default, which is the usual case -- a row is a
/// value, so one blank row can stand for every blank line on the screen.
priv let blank_for t = blank_in (Term.cols t) (Term.pen t);

/// The terminal keeping `history`, trimmed to its limit. Trimmed a tenth at
/// a time, not a line at a time: dropping the front of a trunk is a copy, and
/// a flood of output would make one for every line.
priv let with_history history t = {
    let over = trunk.length history - mode Modes.limit t;
    let cut = if over > num.max 64 (mode Modes.limit t / 10) { over } else { 0 };
    t |> Term.set_history (if cut > 0 { trunk.drop cut history } else { history }) |> Term.set_first (Term.first t + cut)
};

/// The screen's region moved up `n` lines, blank ones coming in at its foot.
/// The whole screen of the main buffer scrolls into the history; anything
/// else -- a region, the alternate screen -- loses the lines it scrolls off.
priv let scroll_up n t = if n <= 0 { t } else {
    let top = mode Modes.top t;
    let bottom = mode Modes.bottom t;
    let span = bottom - top + 1;
    let k = num.min n span;
    let b = blank_for t;
    let g = Term.grid t;
    if top == 0 && bottom == Term.rows t - 1 && not (mode Modes.alt t) {
        // A line at a time, the common case, by push and rest: the history
        // and the screen each a queue, kept in place.
        let history = if k == 1 { trunk.push (trunk.first g) (Term.history t) } else { trunk.concat (Term.history t) (trunk.take k g) };
        let grid = if k == 1 { trunk.push b (trunk.rest g) } else { trunk.concat (trunk.drop k g) (run_of k b) };
        let moved = t |> with_history history |> Term.set_grid grid;
        if k == 1 { touch (Term.rows t - 1) moved } else { list.fold (fn acc y -> touch y acc) moved (list.range (Term.rows t - k) (Term.rows t)) }
    } else {
        let region = trunk.slice (top + k) (bottom + 1) g;
        let g2 = trunk.concat (trunk.concat (trunk.take top g) (trunk.concat region (run_of k b))) (trunk.drop (bottom + 1) g);
        list.fold (fn acc y -> touch y acc) (Term.set_grid g2 t) (list.range top (bottom + 1))
    }
};

/// The region moved down `n` lines, blank ones coming in at its head.
priv let scroll_down n t = if n <= 0 { t } else {
    let top = mode Modes.top t;
    let bottom = mode Modes.bottom t;
    let k = num.min n (bottom - top + 1);
    let g = Term.grid t;
    let region = trunk.slice top (bottom + 1 - k) g;
    let g2 = trunk.concat (trunk.concat (trunk.take top g) (trunk.concat (run_of k (blank_for t)) region)) (trunk.drop (bottom + 1) g);
    list.fold (fn acc y -> touch y acc) (Term.set_grid g2 t) (list.range top (bottom + 1))
};

/// Down a line, scrolling at the foot of the region.
priv let linefeed t = if Term.y t == mode Modes.bottom t { scroll_up 1 t }
    else if Term.y t < Term.rows t - 1 { Term.set_y (Term.y t + 1) t } else { t };

/// Up a line, scrolling back at the head of the region.
priv let reverse_index t = if Term.y t == mode Modes.top t { scroll_down 1 t }
    else if Term.y t > 0 { Term.set_y (Term.y t - 1) t } else { t };

// --- writing ---------------------------------------------------------------------

/// Whether a code point takes two cells: the East Asian wide and fullwidth
/// blocks and the emoji, by range -- what a terminal's font draws double.
let wide : :integer -> :bool;
let wide c = c >= 4352 && ((c <= 4447) || (c >= 11904 && c <= 42191 && c != 12351) || (c >= 44032 && c <= 55203)
    || (c >= 63744 && c <= 64255) || (c >= 65040 && c <= 65049) || (c >= 65072 && c <= 65135)
    || (c >= 65280 && c <= 65376) || (c >= 65504 && c <= 65510) || (c >= 127744 && c <= 128591)
    || (c >= 128640 && c <= 128767) || (c >= 129280 && c <= 129791) || (c >= 131072 && c <= 262141));

/// Whether a code point takes no cell: a combining mark, a joiner.
priv let zero_width c = (c >= 768 && c <= 879) || (c >= 8203 && c <= 8207) || c == 65039 || (c >= 6832 && c <= 6911)
    || (c >= 7616 && c <= 7679) || (c >= 8400 && c <= 8447) || (c >= 65056 && c <= 65071);

/// DEC special graphics, the line-drawing set `ESC ( 0` selects.
priv let dec_graphics c = if c < 96 || c > 126 { c } else {
    list.nth (c - 96) [9670, 9618, 9225, 9228, 9229, 9226, 176, 177, 9252, 9227, 9496, 9488, 9484, 9492, 9532, 9146,
        9147, 9472, 9148, 9149, 9500, 9508, 9524, 9516, 9474, 8804, 8805, 960, 8800, 163, 183]
};

/// The bytes of printable ASCII: text every one of which takes one cell.
priv let ascii = str.of_chars (list.map char.of_code (list.range 32 127));

/// The text `s` written at the cursor, wrapping at the right margin when
/// that mode is on. Printable ASCII -- nearly all of what programs write --
/// goes a run at a time: as much as fits on the line, one slice of the text
/// made one run of the row. Everything else goes a character at a time, since
/// each may be wide, combining, or a line-drawing character.
priv let print s t = {
    let dec = if mode Modes.shifted t { mode Modes.g1_dec t } else { mode Modes.dec t };
    let n = str.byte_length s;
    if not dec && not (mode Modes.insert t) && str.span ascii 0 s == n { print_ascii s 0 n t }
    else { print_each (list.map char.code (str.chars s)) dec t }
};

/// At the right margin with a character still to write: on to the next line
/// when wrapping, the line marked as wrapped; otherwise the last cell again.
priv let margin t w = if mode Modes.autowrap t {
    let done = put_row (Term.y t) (Row.set_wrapped true (row_at (Term.y t) t)) t;
    linefeed (done |> Term.set_x 0 |> Term.set_wrap_next false)
} else { t |> Term.set_x (Term.cols t - w) |> Term.set_wrap_next false };

/// `put_row` with the row made first: a row left suspended would hold the
/// one before it, and a flood of text would build a chain of them.
priv let place_row y !row t = put_row y row t;

priv let rec print_ascii s !i n !t = if i >= n { t } else if Term.wrap_next t { print_ascii s i n (margin t 1) } else {
    let x = Term.x t;
    let cols = Term.cols t;
    let k = num.min (cols - x) (n - i);
    let row = write_run x (Run.make (str.slice i k s) (Term.pen t) k true) (row_at (Term.y t) t);
    let nx = x + k;
    let placed = place_row (Term.y t) row t |> Term.set_last (str.byte (i + k - 1) s);
    let moved = if nx >= cols { placed |> Term.set_x (cols - 1) |> Term.set_wrap_next true } else { Term.set_x nx placed };
    print_ascii s (i + k) n moved
};

priv let rec print_each codes dec !t = match codes {
    [] => t,
    _ => {
        let c0 = list.head codes;
        let c = if dec { dec_graphics c0 } else { c0 };
        if zero_width c { print_each (list.tail codes) dec t } else {
            let w = if wide c { 2 } else { 1 };
            let cols = Term.cols t;
            if Term.wrap_next t || Term.x t + w > cols { print_each codes dec (margin t w) } else {
                let x = Term.x t;
                let style = Term.pen t;
                let row = row_at (Term.y t) t;
                let shifted = if mode Modes.insert t { insert_run x w style cols row } else { row };
                let written = write_run x (Run.make (str.of_chars [char.of_code c]) style w (c < 128)) shifted;
                let nx = x + w;
                let placed = place_row (Term.y t) written t |> Term.set_last c;
                print_each (list.tail codes) dec (if nx >= cols { placed |> Term.set_x (cols - 1) |> Term.set_wrap_next true } else { Term.set_x nx placed })
            }
        }
    },
};

// --- erasing ---------------------------------------------------------------------

/// Cells `[from, to)` of row `y` emptied, in the current background.
priv let erase_cells y from to t = {
    let r = row_at y t;
    let a = num.max 0 from;
    let b = num.min (Term.cols t) to;
    if a >= b { t } else {
        let e = erase_style t;
        // Erasing past the last cell written, in the default background,
        // leaves nothing there: the row just ends sooner.
        let erased = if e == 0 && a >= Row.used r { r }
            else if e == 0 && b >= Row.used r { truncate a r }
            else { write_run a (spaces (b - a) e) r };
        put_row y (if b >= Term.cols t { Row.set_wrapped false erased } else { erased }) t
    }
};

priv let erase_rows from to t = list.fold (fn acc y -> put_row y (blank_for t) acc) t (list.range from to);

/// ED: below the cursor (0), above it (1), the screen (2), or the history (3).
priv let erase_display mode t = match mode {
    0 => erase_rows (Term.y t + 1) (Term.rows t) (erase_cells (Term.y t) (Term.x t) (Term.cols t) t),
    1 => erase_rows 0 (Term.y t) (erase_cells (Term.y t) 0 (Term.x t + 1) t),
    2 => erase_rows 0 (Term.rows t) t,
    3 => t |> Term.set_first (base t) |> Term.set_history trunk.empty |> Term.set_reset true |> touch_all,
    _ => t,
};

/// EL: to the right of the cursor (0), to its left (1), or the line (2).
priv let erase_line mode t = match mode {
    0 => erase_cells (Term.y t) (Term.x t) (Term.cols t) t,
    1 => erase_cells (Term.y t) 0 (Term.x t + 1) t,
    2 => erase_cells (Term.y t) 0 (Term.cols t) t,
    _ => t,
};

/// ICH and DCH: `n` blank cells pushed in at the cursor, or `n` cells taken out.
priv let insert_cells n t = {
    let x = Term.x t;
    let k = num.min n (Term.cols t - x);
    put_row (Term.y t) (insert_run x k (erase_style t) (Term.cols t) (row_at (Term.y t) t)) t
};
priv let delete_cells n t = {
    let x = Term.x t;
    let k = num.min n (Term.cols t - x);
    put_row (Term.y t) (delete_run x k (erase_style t) (Term.cols t) (row_at (Term.y t) t)) t
};

/// IL and DL: lines pushed in at the cursor's, or taken out, within the region.
priv let insert_lines n t = if Term.y t < mode Modes.top t || Term.y t > mode Modes.bottom t { t } else {
    let r = t |> set_mode Modes.set_top (Term.y t) |> scroll_down n;
    r |> set_mode Modes.set_top (mode Modes.top t) |> Term.set_x 0
};
priv let delete_lines n t = if Term.y t < mode Modes.top t || Term.y t > mode Modes.bottom t { t } else {
    // Never into the history: the region starts at the cursor, not the top.
    let saved_alt = mode Modes.alt t;
    let r = t |> set_mode Modes.set_top (Term.y t) |> set_mode Modes.set_alt true |> scroll_up n;
    r |> set_mode Modes.set_top (mode Modes.top t) |> set_mode Modes.set_alt saved_alt |> Term.set_x 0
};

// --- moving ----------------------------------------------------------------------

priv let clamp_x x t = num.clamp 0 (Term.cols t - 1) x;
priv let move_to x y t = {
    let lo = if mode Modes.origin t { mode Modes.top t } else { 0 };
    let hi = if mode Modes.origin t { mode Modes.bottom t } else { Term.rows t - 1 };
    let row = num.clamp lo hi (if mode Modes.origin t { y + mode Modes.top t } else { y });
    t |> Term.set_x (clamp_x x t) |> Term.set_y row |> Term.set_wrap_next false
};
priv let next_tab t = {
    let x = Term.x t;
    let stops = mode Modes.tabs t;
    let rec find c = if c >= Term.cols t - 1 { Term.cols t - 1 }
        else if (map.is_empty stops && c % 8 == 0) || stops.[c else false] { c } else { find (c + 1) };
    Term.set_x (find (x + 1)) t
};

// --- the alternate screen ----------------------------------------------------------

/// To the alternate screen (`?1049h`, and `?47`/`?1047`), and back. The main
/// screen is kept as it was and restored whole; the window is told to forget
/// what it showed, since the same line numbers now hold other text.
priv let enter_alt t = if mode Modes.alt t { t } else {
    t |> set_mode Modes.set_main [Term.grid t, Term.x t, Term.y t, Term.pen t]
      |> Term.set_grid (run_of (Term.rows t) (blank (Term.cols t) 0))
      |> set_mode Modes.set_alt true |> Term.set_reset true |> touch_all
};
priv let leave_alt t = if not (mode Modes.alt t) { t } else {
    let [grid, x, y, p] = mode Modes.main t;
    t |> Term.set_grid (trunk.of (list.map (fn r -> row_fit (Term.cols t) r) (trunk.to_list grid)))
      |> Term.set_x (clamp_x x t) |> Term.set_y (num.min y (Term.rows t - 1)) |> Term.set_pen p
      |> set_mode Modes.set_alt false |> set_mode Modes.set_main () |> Term.set_reset true |> touch_all
};

priv let save_cursor t = set_mode Modes.set_saved (Saved.make (Term.x t) (Term.y t) (Term.pen t) (mode Modes.dec t)) t;
priv let restore_cursor t = match mode Modes.saved t {
    () => move_to 0 0 t,
    s => t |> Term.set_x (clamp_x (Saved.x s) t) |> Term.set_y (num.min (Saved.y s) (Term.rows t - 1))
        |> Term.set_pen (Saved.pen s) |> set_mode Modes.set_dec (Saved.dec s) |> Term.set_wrap_next false,
};

/// RIS: everything as a new terminal of the same size has it, the history kept.
priv let hard_reset t = {
    let fresh = new (Term.cols t) (Term.rows t) (mode Modes.limit t);
    fresh |> Term.set_history (Term.history t) |> Term.set_first (Term.first t)
        |> set_mode Modes.set_title (mode Modes.title t) |> set_mode Modes.set_cwd (mode Modes.cwd t) |> touch_all
};

// --- control characters ----------------------------------------------------------

priv let control b t = match b {
    7 => event [:bell] t,
    8 => t |> Term.set_x (num.max 0 (Term.x t - 1)) |> Term.set_wrap_next false,
    9 => next_tab t,
    10 => linefeed t |> Term.set_wrap_next false,
    11 => linefeed t |> Term.set_wrap_next false,
    12 => linefeed t |> Term.set_wrap_next false,
    13 => t |> Term.set_x 0 |> Term.set_wrap_next false,
    14 => set_mode Modes.set_shifted true t,
    15 => set_mode Modes.set_shifted false t,
    _ => t,
};

// --- select graphic rendition ----------------------------------------------------

/// SGR: the pen changed by the parameters, each `[number, subparameters]`;
/// none at all is `0`, a reset.
priv let sgr_of ps pen = if ps == [] { 0 } else { sgr ps pen };

priv let rec sgr ps !s = match ps {
    [] => s,
    [[p0, subs], ..rest] => {
        let p = num.max 0 p0;
        // The colours first, by tens: they are most of what is asked, and an
        // arm a number made each the last of thirty comparisons.
        match p / 10 {
            3 => if p <= 37 { sgr rest (with_fg (p - 29) s) } else { attribute p subs rest s },
            4 => if p <= 47 { sgr rest (with_bg (p - 39) s) } else { attribute p subs rest s },
            9 => if p <= 97 { sgr rest (with_fg (p - 81) s) } else { sgr rest s },
            10 => if p <= 107 { sgr rest (with_bg (p - 91) s) } else { sgr rest s },
            _ => attribute p subs rest s,
        }
    },
};

/// SGR's other parameters: the attributes, and the colours by number.
priv let attribute p subs rest s = match p {
    0 => sgr rest 0,
    1 => sgr rest (with_flag true bold s),
    2 => sgr rest (with_flag true dim s),
    3 => sgr rest (with_flag true italic s),
    4 => sgr rest (with_flag (subs == [] || list.head subs != 0) underline s),
    5 => sgr rest (with_flag true blink s),
    6 => sgr rest (with_flag true blink s),
    7 => sgr rest (with_flag true inverse s),
    8 => sgr rest (with_flag true hidden s),
    9 => sgr rest (with_flag true strike s),
    21 => sgr rest (with_flag true underline s),
    22 => sgr rest (with_flag false dim (with_flag false bold s)),
    23 => sgr rest (with_flag false italic s),
    24 => sgr rest (with_flag false underline s),
    25 => sgr rest (with_flag false blink s),
    27 => sgr rest (with_flag false inverse s),
    28 => sgr rest (with_flag false hidden s),
    29 => sgr rest (with_flag false strike s),
    39 => sgr rest (with_fg 0 s),
    49 => sgr rest (with_bg 0 s),
    38 => { let [c, more] = extended subs rest; sgr more (with_fg c s) },
    48 => { let [c, more] = extended subs rest; sgr more (with_bg c s) },
    _ => sgr rest s,
};

/// `38`/`48`'s colour, from its subparameters (`38:2::r:g:b`) or the
/// parameters after it (`38;5;n`, `38;2;r;g;b`): `[colour, what is left]`.
priv let extended subs rest = {
    let nums = if subs != [] { subs } else { list.map list.head rest };
    let used = if subs != [] { 0 } else { -1 };
    match nums {
        [5, n, ..] => [1 + num.clamp 0 255 n, if used == 0 { rest } else { list.drop 2 rest }],
        [2, a, b, c, d, ..] => if subs != [] && len subs >= 5 { [16777216 + num.clamp 0 255 b * 65536 + num.clamp 0 255 c * 256 + num.clamp 0 255 d, rest] }
            else { [16777216 + num.clamp 0 255 a * 65536 + num.clamp 0 255 b * 256 + num.clamp 0 255 c, if used == 0 { rest } else { list.drop 4 rest }] },
        [2, a, b, c] => [16777216 + num.clamp 0 255 a * 65536 + num.clamp 0 255 b * 256 + num.clamp 0 255 c, if used == 0 { rest } else { list.drop 4 rest }],
        _ => [0, rest],
    }
};

// --- control sequences -----------------------------------------------------------

/// The parameters of a sequence: each `[number, subparameters]`, `-1` for one left out.
/// Read a byte at a time: a colour change is most of a coloured line's
/// sequences, and splitting its text into strings and parsing each cost more
/// than the rest of the line.
priv let params text = if text == "" { [] } else { param_list text 0 (str.byte_length text) [] };

priv let rec param_list text !i n !acc = {
    let semi = num.min n (str.upto ";" i text);
    let colon = num.min semi (str.upto ":" i text);
    let subs = if colon < semi { sub_list text (colon + 1) semi [] } else { [] };
    let next = list.cons [number text i colon, subs] acc;
    if semi >= n { list.reverse next } else { param_list text (semi + 1) n next }
};

/// The subparameters of one parameter, `0` for one left out.
priv let rec sub_list text !i n !acc = {
    let colon = num.min n (str.upto ":" i text);
    let next = list.cons (num.max 0 (number text i colon)) acc;
    if colon >= n { list.reverse next } else { sub_list text (colon + 1) n next }
};

/// The number written in `[i, j)` of `text`, `-1` for none.
priv let number text i j = if i >= j { -1 } else { digits text i j 0 };

priv let rec digits text !k j !v = if k >= j { v } else {
    let b = str.byte k text;
    if b >= 48 && b <= 57 { digits text (k + 1) j (v * 10 + b - 48) } else { -1 }
};
priv let arg i default ps = if i >= len ps { default } else {
    let v = list.head (list.nth i ps);
    if v <= 0 { default } else { v }
};
priv let arg0 i ps = if i >= len ps { 0 } else { num.max 0 (list.head (list.nth i ps)) };

/// The modes `CSI ? .. h` and `l` set and reset.
priv let private_mode on n t = match n {
    1 => set_mode Modes.set_app_cursor on t,
    6 => move_to 0 0 (set_mode Modes.set_origin on t),
    7 => set_mode Modes.set_autowrap on t,
    12 => t,
    25 => set_mode Modes.set_cursor_visible on t,
    47 => if on { enter_alt t } else { leave_alt t },
    1047 => if on { enter_alt t } else { leave_alt t },
    1048 => if on { save_cursor t } else { restore_cursor t },
    1049 => if on { enter_alt (save_cursor t) } else { restore_cursor (leave_alt t) },
    1000 => set_mode Modes.set_mouse (if on { 1000 } else { 0 }) t,
    1002 => set_mode Modes.set_mouse (if on { 1002 } else { 0 }) t,
    1003 => set_mode Modes.set_mouse (if on { 1003 } else { 0 }) t,
    1004 => set_mode Modes.set_focus_events on t,
    1006 => set_mode Modes.set_sgr_mouse on t,
    2004 => set_mode Modes.set_bracketed on t,
    _ => t,
};

/// A control sequence: `CSI marker params inter final`. The final character
/// says what it is, nearly always with no marker or intermediate, so that is
/// matched alone, and the few with one go on to `csi_marked`. Matching the
/// three as a list, arm by arm, was most of what a coloured flood of output
/// cost: eight hundred reductions a sequence.
priv let csi marker text inter final t = {
    let ps = params text;
    if marker != "" || inter != "" { csi_marked marker inter final ps t } else {
        let a = arg 0 1 ps;
        match final {
            '@' => insert_cells a t,
            'A' => t |> Term.set_y (num.max (if Term.y t >= mode Modes.top t { mode Modes.top t } else { 0 }) (Term.y t - a)) |> Term.set_wrap_next false,
            'B' => t |> Term.set_y (num.min (if Term.y t <= mode Modes.bottom t { mode Modes.bottom t } else { Term.rows t - 1 }) (Term.y t + a)) |> Term.set_wrap_next false,
            'C' => t |> Term.set_x (clamp_x (Term.x t + a) t) |> Term.set_wrap_next false,
            'D' => t |> Term.set_x (clamp_x (Term.x t - a) t) |> Term.set_wrap_next false,
            'E' => move_to 0 (Term.y t + a) (set_mode Modes.set_origin false t) |> set_mode Modes.set_origin (mode Modes.origin t),
            'F' => move_to 0 (Term.y t - a) (set_mode Modes.set_origin false t) |> set_mode Modes.set_origin (mode Modes.origin t),
            'G' => t |> Term.set_x (clamp_x (a - 1) t) |> Term.set_wrap_next false,
            '`' => t |> Term.set_x (clamp_x (a - 1) t) |> Term.set_wrap_next false,
            'H' => move_to (arg 1 1 ps - 1) (a - 1) t,
            'f' => move_to (arg 1 1 ps - 1) (a - 1) t,
            'I' => list.fold (fn acc i -> next_tab acc) t (list.range 0 a),
            'J' => erase_display (arg0 0 ps) t,
            'K' => erase_line (arg0 0 ps) t,
            'L' => insert_lines a t,
            'M' => delete_lines a t,
            'P' => delete_cells a t,
            'S' => scroll_up a t,
            'T' => scroll_down a t,
            'X' => erase_cells (Term.y t) (Term.x t) (Term.x t + a) t,
            'Z' => t |> Term.set_x (num.max 0 (((Term.x t - 1) / 8) * 8 - 8 * (a - 1))),
            'a' => t |> Term.set_x (clamp_x (Term.x t + a) t),
            'b' => print (str.of_chars (list.replicate (num.min a 4096) (char.of_code (Term.last t)))) t,
            'c' => reply "\u{1b}[?62;22c" t,
            'd' => move_to (Term.x t) (a - 1) t,
            'e' => move_to (Term.x t) (Term.y t + a) t,
            'g' => match arg0 0 ps {
                0 => set_mode Modes.set_tabs ((mode Modes.tabs t).[Term.x t => false]) t,
                3 => set_mode Modes.set_tabs (map.from_pairs (list.map (fn c -> [c, false]) (list.range 0 (Term.cols t)))) t,
                _ => t,
            },
            'h' => if arg0 0 ps == 4 { set_mode Modes.set_insert true t } else { t },
            'l' => if arg0 0 ps == 4 { set_mode Modes.set_insert false t } else { t },
            'm' => Term.set_pen (sgr_of ps (Term.pen t)) t,
            'n' => match arg0 0 ps {
                5 => reply "\u{1b}[0n" t,
                6 => reply ("\u{1b}[" + to_string (Term.y t + 1) + ";" + to_string (Term.x t + 1) + "R") t,
                _ => t,
            },
            'r' => {
                let top = arg 0 1 ps - 1;
                let bottom = arg 1 (Term.rows t) ps - 1;
                if top < bottom && bottom < Term.rows t { move_to 0 0 (t |> set_mode Modes.set_top top |> set_mode Modes.set_bottom bottom) } else { t }
            },
            's' => save_cursor t,
            'u' => restore_cursor t,
            _ => t,
        }
    }
};

/// The sequences with a marker (`?`, `>`) or an intermediate byte.
priv let csi_marked marker inter final ps t = match [marker, inter, final] {
    ["?", "", 'J'] => erase_display (arg0 0 ps) t,
    ["?", "", 'K'] => erase_line (arg0 0 ps) t,
    [">", "", 'c'] => reply "\u{1b}[>1;10;0c" t,
    ["?", "", 'h'] => list.fold (fn acc p -> private_mode true (list.head p) acc) t ps,
    ["?", "", 'l'] => list.fold (fn acc p -> private_mode false (list.head p) acc) t ps,
    ["?", "", 'n'] => if arg0 0 ps == 6 { reply ("\u{1b}[?" + to_string (Term.y t + 1) + ";" + to_string (Term.x t + 1) + "R") t } else { t },
    ["", " ", 'q'] => set_mode Modes.set_cursor_shape (match arg0 0 ps { 3 => :underline, 4 => :underline, 5 => :bar, 6 => :bar, _ => :block }) t,
    ["", "!", 'p'] => t |> Term.set_pen 0 |> set_mode Modes.set_insert false |> set_mode Modes.set_origin false |> set_mode Modes.set_autowrap true
        |> set_mode Modes.set_cursor_visible true |> set_mode Modes.set_top 0 |> set_mode Modes.set_bottom (Term.rows t - 1) |> set_mode Modes.set_app_cursor false,
    _ => t,
};

// --- operating system commands ---------------------------------------------------

/// The text after `file://host` in an OSC 7 address, decoded.
priv let path_of u = match str.split_once "://" u {
    () => u,
    [scheme, rest] => match str.find "/" rest { -1 => "/", i => url.decode (str.slice i (str.byte_length rest - i) rest) },
};

priv let osc text t = match str.split_once ";" text {
    () => t,
    [code, body] => match code {
        "0" => event [:title, body] (set_mode Modes.set_title body t),
        "2" => event [:title, body] (set_mode Modes.set_title body t),
        "7" => { let p = path_of body; event [:cwd, p] (set_mode Modes.set_cwd p t) },
        "133" => {
            let [kind, rest] = match str.split_once ";" body { () => [body, ""], kv => kv };
            event [:mark, kind, rest, base t + Term.y t, Term.x t] t
        },
        "633" => match str.split_once ";" body {
            ["E", command] => event [:command, unescape_633 command] t,
            _ => t,
        },
        "1337" => if str.starts_with "CurrentDir=" body { let p = str.trim_prefix "CurrentDir=" body; event [:cwd, p] (set_mode Modes.set_cwd p t) } else { t },
        "10" => if body == "?" { reply "\u{1b}]10;rgb:dcdc/dcdc/e6e6\u{1b}\\" t } else { t },
        "11" => if body == "?" { reply "\u{1b}]11;rgb:0f0f/0f0f/1414\u{1b}\\" t } else { t },
        _ => t,
    },
};

/// A command line as OSC 633 carries it: `\\` and `\xHH` escapes.
priv let unescape_633 s = {
    let rec go cs acc = match cs {
        [] => str.of_chars (list.reverse acc),
        ['\\', '\\', ..rest] => go rest (list.cons '\\' acc),
        ['\\', 'x', a, b, ..rest] => match num.parse_base 16 (str.of_chars [a, b]) {
            () => go rest acc,
            n => go rest (list.cons (char.of_code n) acc),
        },
        _ => go (list.tail cs) (list.cons (list.head cs) acc),
    };
    go (str.chars s) []
};

// --- the parser ------------------------------------------------------------------

/// The bytes that end a run of printable text: C0 controls and DEL.
priv let controls = str.of_chars (list.map char.of_code (list.range 0 32)) + "\u{7f}";
priv let param_bytes = "0123456789;:<=>?";
priv let intermediate_bytes = " !\"#$%&'()*+,-./";
/// How long an unfinished OSC or DCS may grow before it is thrown away.
priv let max_string = 65536;

/// Where the last whole UTF-8 character of `d` ends: an unfinished one at the
/// end is left for the next piece.
priv let utf8_end d = {
    let n = str.byte_length d;
    let rec back k = if k > 3 || k > n { n } else {
        let b = str.byte (n - k) d;
        if b < 128 { n }
        else if b >= 192 {
            let need = if b >= 240 { 4 } else if b >= 224 { 3 } else { 2 };
            if need > k { n - k } else { n }
        } else { back (k + 1) }
    };
    back 1
};

/// The terminal after the program wrote `bytes`.
let feed : Term -> :string -> Term;
let feed t bytes = {
    let d = Term.pending t + bytes;
    let n = utf8_end d;
    let held = str.slice n (str.byte_length d - n) d;
    let after = run (Term.set_pending "" t) d 0 n;
    Term.set_pending (Term.pending after + held) after
};

priv let rec run !t d i n = if i >= n { t } else {
    let b = str.byte i d;
    let flooded = if (b == 13 || b == 27 || (b >= 32 && b < 127)) && flood_ready t { flood t d i n } else { () };
    if flooded != () { let [t2, i2] = flooded; run t2 d i2 n }
    else if b >= 32 && b != 127 {
        let j = str.upto controls i d;
        let k = if j > n { n } else { j };
        run (print (str.slice i (k - i) d) t) d k n
    } else if b == 27 { escape t d i n }
    else { run (control b t) d (i + 1) n }
};

// --- a flood of lines --------------------------------------------------------------
//
// Most of what a terminal is ever given in bulk -- `seq`, `cat` of a log, a
// build's output, `ls --color` -- is lines of text and colour changes, each
// ending `\r\n`, written with the cursor at the foot of the screen. Written
// one at a time, each line is a row written a piece at a time, a carriage
// return, a line feed and a scroll, each a new terminal. Here a run of them
// is made into rows straight away and the screen scrolled once for all of
// them: what the lines one at a time would have come to, for a fraction of
// the work. Anything else -- a sequence that is not a colour, a line too
// long for the screen, a character that is not ASCII -- ends the run, and
// the parser goes on as usual from that line.

/// Whether the terminal is where a flood can be taken whole: the cursor at
/// the start of the bottom line of the main screen, scrolling all of it.
priv let flood_ready t = Term.x t == 0 && Term.y t == Term.rows t - 1 && mode Modes.bottom t == Term.rows t - 1 && mode Modes.top t == 0
    && not (mode Modes.alt t) && not (Term.wrap_next t) && not (mode Modes.insert t) && not (mode Modes.dec t) && not (mode Modes.shifted t);

/// A blank row in the background of pen `p`: the one a line feed brings in.
priv let blank_in cols p = if bg_of p == 0 { empty_row } else { blank cols p };

/// One line of a flood at `i`, written from cell `x` of `row` with pen `pen`:
/// printable ASCII and colour changes, all of it on the screen, then
/// `\r\n`. `[row, pen, last, next]`, `last` the last character written, or
/// `()` where the line is anything else.
//
// Each kind of piece is a function of its own, and none binds a name in a
// branch: the JIT takes a function only when each of its slots is bound once.
priv let rec flood_line d !i n cols !x !pen !last !row = if i >= n { () } else { flood_piece (str.byte i d) d i n cols x pen last row };

priv let flood_piece b d i n cols x pen last row =
    if b == 13 { if i + 1 < n && str.byte (i + 1) d == 10 { [row, pen, last, i + 2] } else { () } }
    else if b >= 32 && b < 127 { flood_text (num.min n (str.upto controls i d)) d i n cols x pen row }
    else if b == 27 && i + 1 < n && str.byte (i + 1) d == 91 { flood_sgr (str.span "0123456789;:" (i + 2) d) d i n cols x pen last row }
    else { () };

/// Printable text from `i` to `j`, if it is ASCII and fits.
priv let flood_text !j d i n cols x pen row =
    if x + j - i > cols || str.span ascii i d < j { () }
    else { flood_line d j n cols (x + j - i) pen (str.byte (j - 1) d) (write_run x (Run.make (str.slice i (j - i) d) pen (j - i) true) row) };

/// A control sequence whose parameters end at `p`, if it is a colour.
priv let flood_sgr !p d i n cols x pen last row =
    if p < n && str.byte p d == 109 { flood_line d (p + 1) n cols x (sgr_of (params (str.slice (i + 2) (p - i - 2) d)) pen) last row }
    else { () };

/// The lines of a flood from `i`, as rows, newest first, how many, where
/// they end, and the pen and last character after them. The first is
/// written over the row the cursor is on, each after it over a blank one.
priv let rec flood_lines d !i n cols !pen !last under !acc !count = match flood_line d i n cols 0 pen last under {
    () => [acc, count, i, pen, last],
    [row, after, wrote, next] => flood_lines d next n cols after wrote (blank_in cols after) (list.cons row acc) (count + 1),
};

/// The terminal after the flood of lines at `i`, and where it ends; `()`
/// when there is not one there.
priv let flood t d i n = {
    let rows = Term.rows t;
    let g = Term.grid t;
    let [newest, m, j, pen, last] = flood_lines d i n (Term.cols t) (Term.pen t) (Term.last t) (trunk.at (rows - 1) g) [] 0;
    if m == 0 { () } else {
        // Every line from the top of the screen down, the flood's in place of
        // the bottom one and a blank after them: the first `m` scroll into
        // the history, and the last `rows` are the screen.
        let all = trunk.concat (trunk.take (rows - 1) g) (trunk.of (list.reverse (list.cons (blank_in (Term.cols t) pen) newest)));
        let foot = base t + rows - 1;
        let moved = t |> with_history (trunk.concat (Term.history t) (trunk.take m all)) |> Term.set_grid (trunk.drop m all);
        let dirty = list.fold (fn acc l -> acc.[l => true]) (Term.dirty moved) (list.range foot (foot + m + 1));
        [moved |> Term.set_dirty dirty |> Term.set_pen pen |> Term.set_last last, j]
    }
};

/// Keep `d` from `i` for the next piece: the sequence there is unfinished.
priv let hold t d i n = if n - i > max_string { t } else { Term.set_pending (str.slice i (n - i) d) t };

priv let escape t d i n = if i + 1 >= n { hold t d i n } else {
    let b = str.byte (i + 1) d;
    match b {
        91 => {
            let start = i + 2;
            let marker = if start < n && str.contains_str (str.slice start 1 d) "<=>?" { str.slice start 1 d } else { "" };
            let p0 = if marker == "" { start } else { start + 1 };
            let p1 = str.span param_bytes p0 d;
            let p2 = str.span intermediate_bytes p1 d;
            if p2 >= n { hold t d i n } else {
                let fb = str.byte p2 d;
                if fb < 64 || fb > 126 { run t d (p2 + 1) n }
                else { run (csi marker (str.slice p0 (p1 - p0) d) (str.slice p1 (p2 - p1) d) (char.of_code fb) t) d (p2 + 1) n }
            }
        },
        93 => string_seq t d i n true,
        80 => string_seq t d i n false,
        95 => string_seq t d i n false,
        94 => string_seq t d i n false,
        88 => string_seq t d i n false,
        40 => designate t d i n false,
        41 => designate t d i n true,
        42 => if i + 2 >= n { hold t d i n } else { run t d (i + 3) n },
        43 => if i + 2 >= n { hold t d i n } else { run t d (i + 3) n },
        35 => if i + 2 >= n { hold t d i n } else { run t d (i + 3) n },
        37 => if i + 2 >= n { hold t d i n } else { run t d (i + 3) n },
        _ => run (single b t) d (i + 2) n,
    }
};

priv let designate t d i n g1 = if i + 2 >= n { hold t d i n } else {
    let dec = str.byte (i + 2) d == 48;
    run (if g1 { set_mode Modes.set_g1_dec dec t } else { set_mode Modes.set_dec dec t }) d (i + 3) n
};

/// OSC, DCS, APC, PM and SOS: a string up to BEL or ST. Only OSC's is read.
priv let string_seq t d i n is_osc = {
    let j = str.upto "\u{7}\u{1b}" (i + 2) d;
    if j >= n { hold t d i n }
    else if str.byte j d == 7 {
        let body = str.slice (i + 2) (j - i - 2) d;
        run (if is_osc { osc body t } else { t }) d (j + 1) n
    } else if j + 1 >= n { hold t d i n }
    else if str.byte (j + 1) d == 92 {
        let body = str.slice (i + 2) (j - i - 2) d;
        run (if is_osc { osc body t } else { t }) d (j + 2) n
    } else {
        // An ESC that is not ST ends the string without one, as xterm treats it.
        run t d j n
    }
};

priv let single b t = match b {
    55 => save_cursor t,
    56 => restore_cursor t,
    68 => linefeed t,
    69 => linefeed (Term.set_x 0 t),
    77 => reverse_index t,
    99 => hard_reset t,
    61 => set_mode Modes.set_app_keypad true t,
    62 => set_mode Modes.set_app_keypad false t,
    72 => set_mode Modes.set_tabs ((mode Modes.tabs t).[Term.x t => true]) t,
    _ => t,
};

// --- resizing --------------------------------------------------------------------

/// The terminal at a new size. Rows are cut or padded, not reflowed; a screen
/// that loses rows gives its top ones to the history, so the cursor's line
/// stays on it; one that gains rows gains them at the foot.
let resize : Term -> :integer -> :integer -> Term;
let resize t cols rows = if cols == Term.cols t && rows == Term.rows t { t } else {
    let fitted = trunk.of (list.map (fn r -> row_fit cols r) (trunk.to_list (Term.grid t)));
    let have = Term.rows t;
    let t1 = t |> Term.set_cols cols |> Term.set_grid fitted;
    let t2 = if rows < have {
        let cut = num.max 0 (Term.y t - (rows - 1));
        let lift = if mode Modes.alt t { t1 |> Term.set_grid (trunk.drop cut (Term.grid t1)) }
            else { t1 |> Term.set_history (trunk.concat (Term.history t1) (trunk.take cut (Term.grid t1)))
                      |> Term.set_grid (trunk.drop cut (Term.grid t1)) };
        lift |> Term.set_grid (trunk.take rows (Term.grid lift)) |> Term.set_y (Term.y t - cut)
    } else {
        t1 |> Term.set_grid (trunk.concat (Term.grid t1) (trunk.of (list.map (fn i -> blank cols 0) (list.range 0 (rows - have)))))
    };
    let main = match mode Modes.main t2 {
        () => (),
        [g, x, y, p] => [trunk.of (list.map (fn r -> row_fit cols r)
            (list.take rows (list.append (trunk.to_list g) (list.map (fn i -> blank cols 0) (list.range 0 rows))))),
            num.min x (cols - 1), num.min y (rows - 1), p],
    };
    t2 |> Term.set_rows rows |> set_mode Modes.set_main main |> set_mode Modes.set_top 0 |> set_mode Modes.set_bottom (rows - 1)
       |> Term.set_x (num.min (Term.x t2) (cols - 1)) |> Term.set_y (num.clamp 0 (rows - 1) (Term.y t2))
       |> Term.set_wrap_next false |> Term.set_reset true |> touch_all
};

/// The text of lines `[from, to)`, a wrapped line joined to the next.
let text_between : Term -> :integer -> :integer -> :string;
let text_between t from to = {
    let rows = list.flat_map (fn n -> match line t n { () => [], r => [r] }) (list.range from to);
    str.concat_all (list.map (fn r -> row_text r + (if Row.wrapped r { "" } else { "\n" })) rows)
};

when test {
    import std.test;
    let screen t = list.map (fn y -> row_text (trunk.at y (Term.grid t))) (list.range 0 (Term.rows t));
    let tests = [
        test.case "text is written at the cursor and wraps" $({
            let t = feed (new 5 3 100) "hello world";
            test.eq! ["hello", " worl", "d"] (screen t)
            test.eq! [2, 1] (cursor t)
        }),
        test.case "a newline at the foot scrolls into the history" $({
            let t = feed (new 10 2 100) "one\r\ntwo\r\nthree";
            test.eq! ["two", "three"] (screen t)
            test.eq! ["one", 1] [line_text t 0, base t]
        }),
        test.case "colours and attributes become a style" $({
            let t = feed (new 20 1 10) "\u{1b}[1;31mred\u{1b}[0m \u{1b}[38;5;196mx\u{1b}[48;2;1;2;3my";
            let row = trunk.at 0 (Term.grid t);
            test.eq! [["red", "var(--dw-ansi-1)", "", 1], [" ", "", "", 0], ["x", "#ff0000", "", 0], ["y", "#ff0000", "#010203", 0]] (spans row)
        }),
        test.case "the cursor moves and lines are erased" $({
            let t = feed (new 10 3 10) "aaaa\r\nbbbb\r\ncccc\u{1b}[2;3H\u{1b}[K\u{1b}[1;1H\u{1b}[2P";
            test.eq! ["aa", "bb", "cccc"] (screen t)
        }),
        test.case "a sequence split across pieces is finished by the next" $({
            let t = feed (feed (new 10 1 10) "a\u{1b}[3") "1mb";
            test.eq! [["a", "", "", 0], ["b", "var(--dw-ansi-1)", "", 0]] (spans (trunk.at 0 (Term.grid t)))
        }),
        test.case "a UTF-8 character split across pieces is whole" $({
            let snow = "\u{2603}";
            let a = str.slice 0 2 snow;
            let b = str.slice 2 1 snow;
            test.eq! ["\u{2603}"] (screen (feed (feed (new 4 1 10) a) b) |> list.map str.trim)
        }),
        test.case "the alternate screen keeps the main one" $({
            let t = feed (new 10 2 10) "shell$ \u{1b}[?1049h\u{1b}[Hvim\u{1b}[?1049l";
            test.eq! ["shell$", ""] (list.map str.trim (screen t))
            test.eq! [0, 7] (cursor t)
        }),
        test.case "a scroll region scrolls alone" $({
            let t = feed (new 5 4 10) "1\r\n2\r\n3\r\n4\u{1b}[2;3r\u{1b}[3;1H\n";
            test.eq! ["1", "3", "", "4"] (screen t)
            test.eq! 0 (base t)
        }),
        test.case "line drawing draws lines" $(test.eq! ["\u{250c}\u{2500}\u{2510}"]
            (screen (feed (new 3 1 10) "\u{1b}(0lqk\u{1b}(B"))),
        test.case "the cursor's place is reported" $({
            let [lines, replies, events, reset, t, dropped] = take_updates 100 (feed (new 10 5 10) "ab\u{1b}[6n");
            test.eq! ["\u{1b}[1;3R"] replies
        }),
        test.case "shell integration marks and the directory are events" $({
            let [lines, replies, events, reset, t, dropped] = take_updates 100 (feed (new 20 2 10)
                "\u{1b}]133;A\u{7}$ \u{1b}]133;B\u{7}ls\u{1b}]633;E;ls -la\u{7}\u{1b}]7;file://host/home/me%20x\u{1b}\\\u{1b}]133;D;1\u{7}");
            test.eq! [[:mark, "A", "", 0, 0], [:mark, "B", "", 0, 2], [:command, "ls -la"], [:cwd, "/home/me x"], [:mark, "D", "1", 0, 4]] events
        }),
        test.case "only changed lines are reported, and then forgotten" $({
            let [l1, _, _, _, t1, _] = take_updates 100 (new 10 3 10);
            let [l2, _, _, _, t2, _] = take_updates 100 (feed t1 "\u{1b}[2;1Hx");
            let [l3, _, _, _, _, _] = take_updates 100 t2;
            test.eq! [0, [[1, [["x", "", "", 0]]]], []] [len l1, l2, l3]
        }),
        test.case "wide characters take two cells" $({
            let t = feed (new 6 1 10) "\u{4e2d}\u{6587}ab";
            test.eq! [[0, 6], "\u{4e2d}\u{6587}ab"] [cursor t |> (fn c -> [list.head c, list.nth 1 c + 1]), row_text (trunk.at 0 (Term.grid t))]
        }),
        test.case "a smaller window gives its top lines to the history" $({
            let t = resize (feed (new 5 4 10) "1\r\n2\r\n3\r\n4") 5 2;
            test.eq! [["3", "4"], 2, [3, 1]] [screen t, base t, cursor t]
        }),
        test.case "colours are CSS" $(test.eq! ["", "var(--dw-ansi-9)", "#5f87af", "#808080", "#0a0b0c"]
            [css_colour 0, css_colour 10, css_colour (1 + 67), css_colour (1 + 244), css_colour (16777216 + 10 * 65536 + 11 * 256 + 12)]),
    ];
}
