    r "hosts file edit" "sudoedit /etc/hosts" "Edit the names this machine resolves itself",
    r "serve files http quick share" "python3 -m http.server {port} --bind 0.0.0.0" "Share this directory on the local network",

    // SSH and remote machines.
    r "copy ssh key to server" "ssh-copy-id {user}@{host}" "Log in without a password from now on",
    r "ssh port forwarding tunnel local" "ssh -L {port}:localhost:{port} {user}@{host}" "Reach a server's port as if it were here",
    r "ssh reverse tunnel remote forward" "ssh -R {port}:localhost:{port} {user}@{host}" "Let a server reach a port here",
    r "ssh socks proxy" "ssh -D 1080 {user}@{host}" "A SOCKS proxy through a server",
    r "run command on remote server ssh" "ssh {user}@{host} '{name}'" "Run one command on another machine",
    r "copy file from server scp download" "scp {user}@{host}:{path} ." "Fetch a file from another machine",
    r "copy directory to server recursively" "scp -r {path} {user}@{host}:~/" "Send a directory to another machine",
    r "ssh agent add key" "eval $(ssh-agent) && ssh-add" "Remember your key's passphrase for this session",
    r "ssh jump host bastion" "ssh -J {user}@{host} {user}@{name}" "Reach a machine through another",
    r "mount remote folder sshfs" "sshfs {user}@{host}:{path} ~/mnt" "A remote directory as a local one",
    r "ssh key fingerprint" "ssh-keygen -lf ~/.ssh/id_ed25519.pub" "Your key's fingerprint",
    r "remove host key known hosts changed" "ssh-keygen -R {host}" "Forget a host's old key",
    r "keep ssh session alive tmux" "tmux new -s {name}" "A session that survives disconnecting",
    r "tmux attach session" "tmux attach -t {name}" "Go back to a tmux session",
    r "tmux list sessions" "tmux ls" "Running tmux sessions",
    r "screen detach session" "screen -S {name}" "A screen session to come back to",

    // Git, more of it.
    r "git init new repository" "git init && git add . && git commit -m 'Initial commit'" "Start a repository here",
    r "git clone repository" "git clone {host}" "A copy of a repository",
    r "git clone shallow depth" "git clone --depth 1 {host}" "Only the latest commit, faster",
    r "git status short" "git status -sb" "What has changed, briefly",
    r "git add all commit" "git add -A && git commit -m '{name}'" "Commit everything",
    r "git commit only some changes interactively" "git add -p" "Choose which changes to stage, piece by piece",
    r "git throw away last commit and its work hard reset" "git reset --hard HEAD~1" "Throw away the last commit and its changes",
    r "git revert a pushed commit with a new one" "git revert {name}" "A new commit that undoes an old one",
    r "git checkout file from another branch" "git restore --source {branch} {path}" "A file as it is on another branch",
    r "git restore deleted file" "git restore {path}" "Bring back a file deleted since the last commit",
    r "git merge branch" "git merge {branch}" "Bring another branch's work into this one",
    r "git rebase onto main" "git rebase main" "Replay this branch's commits on top of main",
    r "git abort merge rebase" "git merge --abort || git rebase --abort" "Back out of a merge or rebase in progress",
    r "git continue rebase after conflict" "git add -A && git rebase --continue" "Carry on once conflicts are fixed",
    r "git list conflicts conflicted files" "git diff --name-only --diff-filter=U" "Files still in conflict",
    r "git squash commits" "git reset --soft HEAD~{n} && git commit" "The last n commits as one",
    r "git cherry pick commit" "git cherry-pick {name}" "Copy one commit onto this branch",
    r "git rename branch" "git branch -m {branch}" "Give this branch a new name",
    r "git delete remote branch" "git push origin --delete {branch}" "Delete a branch on the remote",
    r "git force push safely" "git push --force-with-lease" "Overwrite the remote branch, unless someone else pushed",
    r "git fetch prune remote branches" "git fetch --prune" "Bring in remote changes, forget deleted branches",
    r "git remote add origin url" "git remote add origin {host}" "Connect a repository to a remote",
    r "git change remote url" "git remote set-url origin {host}" "Point origin somewhere else",
    r "git show remotes" "git remote -v" "Where this repository pushes and pulls",
    r "git show commit changes" "git show {name}" "What a commit changed",
    r "git diff between branches" "git diff main...{branch}" "What a branch changed since it left main",
    r "git files changed in commit" "git show --stat {name}" "Which files a commit touched",
    r "git history of file" "git log --follow -p {path}" "Every change to a file, renames followed",
    r "git search code history pickaxe" "git log -S '{name}' --oneline" "Commits that added or removed the text",
    r "git commits by author" "git log --author='{name}' --oneline" "One person's commits",
    r "git count commits by author shortlog" "git shortlog -sn" "Who has committed most",
    r "git commits since date" "git log --since='{n} days ago' --oneline" "What was committed recently",
    r "git find which commit introduced bug bisect" "git bisect start && git bisect bad && git bisect good {name}" "Binary-search the history for where it broke",
    r "git reflog recover lost commit" "git reflog" "Everywhere HEAD has been, to get lost work back",
    r "git ignore file already tracked" "git rm --cached {path}" "Stop tracking a file but keep it",
    r "git list ignored files" "git status --ignored" "Files .gitignore is hiding",
    r "git submodule update init" "git submodule update --init --recursive" "Fetch every submodule",
    r "git worktree add" "git worktree add ../{branch} {branch}" "Another branch checked out beside this one",
    r "git stash list" "git stash list" "What has been put aside",
    r "git stash including untracked" "git stash push -u" "Put aside changes, new files too",
    r "git config user name email" "git config --global user.name '{name}'" "Set your name for commits",
