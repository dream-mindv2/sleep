// Asking for a command in words: "find files bigger than 100 MB",
// "what is listening on port 8080", "undo the last commit".
//
// A cookbook of tasks, each a few ways of saying it and a command with holes
// in it, searched by meaning: the question and every task are TF-IDF
// vectors of their words and their character trigrams (`std.ml.text`), so
// "biggest files" finds "find large files" and "lisening" still finds
// "listening". The holes are filled from the question -- a number, a size, a
// port, a quoted name, a file extension, a branch -- and a hole the question
// does not fill keeps a placeholder for the person to type over.
//
// It runs nothing. It answers commands for a person to read, change and run.
import std.char;
import std.list;
import std.map;
import std.ml.text;
import std.num;
import std.regex;
import std.str;

/// A task: how it is asked, and the command, with `{n}`, `{size}`, `{port}`,
/// `{name}`, `{ext}`, `{path}`, `{branch}`, `{host}`, `{pid}` or `{user}` for
/// what the question says.
mapping Recipe {
    ask : :string = ""
    command : :string = ""
    note : :string = ""
}

priv let r ask command note = Recipe.new () |> Recipe.set_ask ask |> Recipe.set_command command |> Recipe.set_note note;

let recipes : [Recipe];
let recipes = [
    r "find large big biggest files bigger than size" "find . -type f -size +{size} -exec ls -lh {} + | sort -k5 -rh | head -20" "Files over the size, largest first",
    r "find files by name named called" "find . -name '{name}'" "Files with that name, below here",
    r "find files with extension type ending" "find . -type f -name '*.{ext}'" "Files of that type, below here",
    r "find files modified changed recently in the last days" "find . -type f -mtime -{n}" "Files changed in the last n days",
    r "search grep text inside files containing string" "grep -rn '{name}' ." "Lines containing the text, with file and line",
    r "count lines of code in files" "find . -name '*.{ext}' | xargs wc -l | tail -1" "Total lines in files of that type",
    r "disk usage of folder directory size how big" "du -sh {path}" "How much space a directory takes",
    r "what is using disk space largest directories" "du -h --max-depth=1 . | sort -rh | head -20" "The largest directories here",
    r "free disk space left on drives" "df -h" "Free space on each mounted drive",
    r "memory usage ram free" "free -h" "Memory in use and free",
    r "what process is listening on port who uses port" "lsof -i :{port}" "The process that has the port open",
    r "kill process on port free port" "kill $(lsof -t -i :{port})" "Stop whatever is listening on the port",
    r "list open ports listening sockets" "ss -tulpn" "Every listening TCP and UDP socket, with its process",
    r "kill process by name stop program" "pkill -f '{name}'" "Stop processes whose command line matches",
    r "kill process by id pid" "kill {pid}" "Ask a process to stop",
    r "force kill process" "kill -9 {pid}" "Stop a process at once, without letting it clean up",
    r "list processes running top cpu usage" "ps aux --sort=-%cpu | head -15" "The processes using the most CPU",
    r "processes using most memory" "ps aux --sort=-%mem | head -15" "The processes using the most memory",
    r "find process by name" "pgrep -af '{name}'" "Processes whose command line matches",
    r "watch a log file follow tail" "tail -f {path}" "Show lines as they are added",
    r "show last lines of file" "tail -n {n} {path}" "The last lines of a file",
    r "count lines in file" "wc -l {path}" "How many lines a file has",
    r "make script executable permission" "chmod +x {path}" "Allow running a file as a program",
    r "change owner of files" "sudo chown -R $USER {path}" "Make files yours",
    r "create directory folder with parents" "mkdir -p {path}" "Make a directory and any missing parents",
    r "copy directory recursively" "cp -r {path} {path}.copy" "Copy a directory and everything in it",
    r "rename move file" "mv {path} {name}" "Rename or move a file",
    r "compress folder tar gz archive" "tar -czf {name}.tar.gz {path}" "Pack a directory into a .tar.gz",
    r "extract unpack tar gz archive" "tar -xzf {path}" "Unpack a .tar.gz here",
    r "zip folder" "zip -r {name}.zip {path}" "Pack a directory into a .zip",
    r "unzip file" "unzip {path}" "Unpack a .zip here",
    r "download file from url" "curl -LO {host}" "Save what a URL points to",
    r "http request get url headers" "curl -i {host}" "Fetch a URL, showing the response's headers",
    r "post json to api" "curl -X POST -H 'Content-Type: application/json' -d '{}' {host}" "Send JSON to a URL",
    r "check if host is up ping" "ping -c 4 {host}" "Is a host reachable",
    r "dns lookup ip address of domain" "dig +short {host}" "The address a name resolves to",
    r "my public ip address" "curl -s https://ifconfig.me" "Your address as the internet sees it",
    r "local ip address network interfaces" "ip -brief addr" "This machine's addresses",
    r "ssh into server connect remote" "ssh {user}@{host}" "Open a shell on another machine",
    r "copy file to server scp" "scp {path} {user}@{host}:~/" "Copy a file to another machine",
    r "sync folders rsync" "rsync -avh --progress {path} {user}@{host}:{path}" "Copy only what changed",
    r "generate ssh key" "ssh-keygen -t ed25519 -C \"$USER@$(hostname)\"" "A new SSH key pair",
    r "git undo last commit keep changes" "git reset --soft HEAD~1" "Take back the last commit; its changes stay staged",
    r "git discard local changes" "git restore ." "Throw away changes not yet staged",
    r "git unstage files" "git restore --staged ." "Take files back out of the next commit",
    r "git create new branch switch" "git switch -c {branch}" "A new branch, from here",
    r "git delete branch" "git branch -d {branch}" "Delete a branch that has been merged",
    r "git list branches recent" "git branch --sort=-committerdate | head" "Branches, most recently used first",
    r "git show history log graph" "git log --oneline --graph --decorate -20" "Recent commits as a graph",
    r "git who changed line blame" "git blame {path}" "Who last changed each line",
    r "git stash save changes for later" "git stash push -m '{name}'" "Put changes aside",
    r "git apply stash restore" "git stash pop" "Bring back the last changes put aside",
    r "git amend last commit message" "git commit --amend" "Change the last commit",
    r "git push new branch upstream" "git push -u origin HEAD" "Push this branch and track it",
    r "git pull rebase update" "git pull --rebase" "Bring in the remote's commits under yours",
    r "git diff staged changes" "git diff --staged" "What the next commit will hold",
    r "git find commit by message search" "git log --oneline --grep='{name}'" "Commits whose message mentions it",
    r "git clean untracked files" "git clean -nd" "Which untracked files would be removed (add -f to remove)",
    r "git tag release version" "git tag -a v{n} -m 'v{n}'" "Tag this commit as a release",
    r "docker list running containers" "docker ps" "Containers that are running",
    r "docker stop all containers" "docker stop $(docker ps -q)" "Stop every running container",
    r "docker remove unused images prune clean" "docker system prune" "Remove stopped containers and unused images",
    r "docker shell into container exec" "docker exec -it {name} sh" "A shell inside a running container",
    r "docker logs of container follow" "docker logs -f {name}" "A container's output as it comes",
    r "docker build image" "docker build -t {name} ." "Build an image from the Dockerfile here",
    r "docker compose start up" "docker compose up -d" "Start the services in compose.yaml",
    r "python virtual environment venv create" "python3 -m venv .venv && . .venv/bin/activate" "An isolated Python environment",
    r "python install requirements" "pip install -r requirements.txt" "Install a project's dependencies",
    r "python simple http server serve folder" "python3 -m http.server {port}" "Serve this directory over HTTP",
    r "node install dependencies" "npm install" "Install a project's dependencies",
    r "run npm script" "npm run {name}" "Run a script from package.json",
    r "rust build release" "cargo build --release" "An optimized build",
    r "run tests rust cargo" "cargo test" "Run the test suite (Rust); npm test, pytest, go test ./... for others",
    r "systemd service status restart" "systemctl status {name}" "Whether a service is running, and its last log lines",
    r "service logs journal" "journalctl -u {name} -f" "A service's log as it comes",
    r "list installed packages" "apt list --installed" "Installed packages (Debian, Ubuntu)",
    r "update system packages upgrade" "sudo apt update && sudo apt upgrade" "Bring packages up to date (Debian, Ubuntu)",
    r "show environment variables" "env | sort" "Every environment variable",
    r "set environment variable" "export {name}=value" "Set a variable for this shell and what it starts",
    r "add to path" "export PATH=\"$PATH:{path}\"" "Make programs in a directory runnable by name",
    r "current date time timestamp" "date -Iseconds" "Now, in ISO 8601",
    r "convert unix timestamp to date" "date -d @{n}" "A timestamp as a date",
    r "calculate checksum sha256 hash of file" "sha256sum {path}" "A file's SHA-256",
    r "base64 encode decode" "base64 {path}" "A file as base64 (base64 -d to decode)",
    r "random password generate" "openssl rand -base64 {n}" "Random bytes as text",
    r "pretty print json format" "python3 -m json.tool {path}" "JSON laid out to read",
    r "jq extract field from json" "jq '.{name}' {path}" "One field of a JSON document",
    r "replace text in files sed" "sed -i 's/old/new/g' {path}" "Replace text in a file",
    r "sort unique count lines" "sort {path} | uniq -c | sort -rn | head" "The commonest lines, with counts",
    r "compare two files diff" "diff -u {path} {name}" "How two files differ",
    r "run command every few seconds watch" "watch -n {n} '{name}'" "Run a command again and again",
    r "time how long a command takes" "time {name}" "How long a command takes",
    r "repeat last command with sudo" "sudo !!" "The last command again, as root",
    r "search command history" "history | grep '{name}'" "Earlier commands that mention it",
    r "who is logged in users" "who" "Who is logged in",
    r "system information kernel version" "uname -a" "The kernel and the machine",
    r "cpu information cores" "lscpu" "The processor",
    r "gpu usage nvidia" "nvidia-smi" "The GPU and what is using it",
    r "reboot restart computer" "sudo reboot" "Restart the machine",

    // Files: finding, comparing, cleaning up.
    r "find empty files" "find . -type f -empty" "Files with nothing in them",
    r "find empty directories folders" "find . -type d -empty" "Directories with nothing in them",
    r "delete empty directories folders" "find . -type d -empty -delete" "Remove every empty directory below here",
    r "find duplicate files same content" "find . -type f -exec sha256sum {} + | sort | uniq -w64 -dD" "Files whose bytes are the same, grouped",
    r "find newest most recently modified files" "find . -type f -printf '%T@ %p\\n' | sort -rn | head -20 | cut -d' ' -f2-" "The files changed most recently",
    r "find oldest files" "find . -type f -printf '%T@ %p\\n' | sort -n | head -20 | cut -d' ' -f2-" "The files left alone longest",
    r "find files older than days delete old files" "find {path} -type f -mtime +{n} -print" "Files not changed in n days (add -delete to remove them)",
    r "find files changed in the last minutes" "find . -type f -mmin -{n}" "Files changed in the last n minutes",
    r "find files owned by user" "find . -user {user}" "Files that belong to a user",
    r "find files with permission executable" "find . -type f -perm -u+x" "Files you can run",
    r "find world writable files insecure permissions" "find . -type f -perm -o+w" "Files anyone may change",
    r "find broken symlinks dangling links" "find . -xtype l" "Links that point at nothing",
    r "find symlinks links" "find . -type l -ls" "Every symbolic link, and where it points",
    r "find and delete files by name pattern" "find . -name '{name}' -delete" "Remove files with that name, below here",
    r "find files ignoring case name" "find . -iname '*{name}*'" "Files whose name contains it, any case",
    r "find directories folders by name" "find . -type d -name '{name}'" "Directories with that name",
    r "find files exclude directory skip node_modules" "find . -path ./node_modules -prune -o -type f -name '*.{ext}' -print" "Files of a type, skipping a directory",
    r "fd fast find files" "fd '{name}'" "fd: a faster find, that respects .gitignore",
    r "locate file anywhere on system" "locate '{name}'" "Search the whole system's file index (updatedb refreshes it)",
    r "which program path where is command installed" "command -v {name}" "Where a command comes from",
    r "what type of file is this" "file {path}" "What a file holds, from its first bytes",
    r "file size in bytes" "stat -c %s {path}" "A file's size in bytes",
    r "file details metadata timestamps stat" "stat {path}" "A file's size, owner, mode and times",
    r "touch create empty file update timestamp" "touch {path}" "Make an empty file, or mark one changed now",
    r "delete directory folder recursively remove" "rm -r {path}" "Remove a directory and everything in it",
    r "delete file safely to trash" "gio trash {path}" "Move a file to the trash instead of deleting it",
    r "symbolic link create symlink" "ln -s {path} {name}" "A link called name that points at path",
    r "list files sorted by size" "ls -lhS" "Files here, largest first",
    r "list files sorted by time modified" "ls -lht" "Files here, newest first",
    r "list hidden files dotfiles" "ls -la" "Every file here, the hidden ones too",
    r "tree view directory structure" "tree -L 2 {path}" "A directory's layout, two levels deep",
    r "count files in directory" "find {path} -type f | wc -l" "How many files are below a directory",
    r "biggest files in home directory" "du -ah ~ 2>/dev/null | sort -rh | head -20" "The largest things in your home",
    r "interactive disk usage explorer" "ncdu {path}" "Browse what takes the space, interactively",
    r "copy file preserving permissions timestamps" "cp -a {path} {name}" "Copy keeping mode, owner and times",
    r "move all files of type into folder" "mkdir -p {name} && mv *.{ext} {name}/" "Gather files of a type into a directory",
    r "rename many files bulk extension" "for f in *.{ext}; do mv \"$f\" \"${f%.{ext}}.txt\"; done" "Change the extension of every file of a type",
    r "lowercase file names rename" "for f in *; do mv -n \"$f\" \"$(echo \"$f\" | tr A-Z a-z)\"; done" "Make every file name here lowercase",
    r "replace spaces in file names" "for f in *\\ *; do mv -n \"$f\" \"${f// /_}\"; done" "Underscores for spaces in names",
    r "split large file into pieces" "split -b {size} {path} {name}.part." "Cut a file into pieces of a size",
    r "join split files back together" "cat {name}.part.* > {name}" "Put pieces back into one file",
    r "make a file of a given size dummy test" "truncate -s {size} {name}" "A file of that size, for testing",
    r "shred securely delete file" "shred -u {path}" "Overwrite a file, then remove it",
    r "watch directory for changes" "inotifywait -m -r {path}" "Report every change below a directory as it happens",
    r "mount usb drive disk" "udisksctl mount -b /dev/{name}" "Mount a removable drive",
    r "list disks partitions drives" "lsblk -f" "Drives, partitions and their filesystems",
    r "unmount drive eject" "udisksctl unmount -b /dev/{name}" "Unmount a drive before taking it out",
    r "check filesystem usage inodes" "df -i" "How many files each filesystem can still hold",
    r "open file with default application" "xdg-open {path}" "Open a file the way the desktop would",
    r "open current folder in file manager" "xdg-open ." "This directory in the file manager",

    // Text: searching, cutting, rewriting.
    r "search text ignoring case" "grep -rni '{name}' ." "Lines containing it, any case",
    r "search only files of type grep" "grep -rn --include='*.{ext}' '{name}' ." "Search only files of a type",
    r "list files containing text names only" "grep -rl '{name}' ." "The files that mention it",
    r "files not containing text" "grep -rL '{name}' ." "The files that do not mention it",
    r "search whole word" "grep -rnw '{name}' ." "Lines with it as a whole word",
    r "count occurrences matches of word" "grep -ro '{name}' . | wc -l" "How many times it appears",
    r "ripgrep fast search code" "rg '{name}'" "ripgrep: a faster grep that respects .gitignore",
    r "search with context lines around match" "grep -rn -C 3 '{name}' ." "Matches with three lines either side",
    r "search regex pattern extended" "grep -rnE '{name}' ." "Search with an extended regular expression",
    r "exclude lines matching invert grep" "grep -v '{name}' {path}" "Lines that do not match",
    r "show first lines of file head" "head -n {n} {path}" "The first lines of a file",
    r "show specific line number of file" "sed -n '{n}p' {path}" "Line n of a file",
    r "show range of lines" "sed -n '10,20p' {path}" "Lines 10 to 20 of a file",
    r "delete lines matching pattern" "sed -i '/{name}/d' {path}" "Remove lines that match, in place",
    r "remove blank empty lines" "sed -i '/^$/d' {path}" "Remove empty lines, in place",
    r "remove trailing whitespace" "sed -i 's/[[:space:]]*$//' {path}" "Strip spaces at line ends, in place",
    r "replace text in many files recursively" "grep -rl 'old' . | xargs sed -i 's/old/new/g'" "Replace text in every file that has it",
    r "print column field awk" "awk '{print $1}' {path}" "The first column of each line",
    r "cut column csv delimiter" "cut -d, -f{n} {path}" "Column n of a CSV",
    r "sum numbers column total" "awk '{s+=$1} END {print s}' {path}" "The total of the first column",
    r "unique lines remove duplicates" "sort -u {path}" "Each line once, sorted",
    r "remove duplicate lines keep order" "awk '!seen[$0]++' {path}" "Each line once, in the order they came",
    r "sort numerically numbers" "sort -n {path}" "Lines in numeric order",
    r "reverse lines order" "tac {path}" "Lines last first",
    r "shuffle lines random order" "shuf {path}" "Lines in random order",
    r "random line pick" "shuf -n 1 {path}" "One line at random",
    r "count words characters" "wc -w {path}" "How many words a file has",
    r "lines in common between two files" "comm -12 <(sort {path}) <(sort {name})" "Lines both files have",
    r "side by side diff compare" "diff -y {path} {name}" "Two files side by side",
    r "word diff changes" "git diff --no-index --word-diff {path} {name}" "Two files compared word by word",
    r "convert to uppercase" "tr a-z A-Z < {path}" "A file in capitals",
    r "convert dos windows line endings crlf" "sed -i 's/\\r$//' {path}" "Unix line endings for a file from Windows",
    r "convert file encoding utf8" "iconv -f latin1 -t utf-8 {path} > {name}" "Re-encode a file as UTF-8",
    r "join lines into one comma separated" "paste -sd, {path}" "Every line, joined with commas",
    r "number lines" "nl -ba {path}" "A file with line numbers",
    r "wrap long lines" "fold -w 80 -s {path}" "Lines wrapped at 80 columns",
    r "columns align table" "column -t -s, {path}" "A CSV laid out as a table",
    r "longest line in file" "awk '{ if (length > m) { m = length; l = $0 } } END { print l }' {path}" "The longest line",
    r "page through file less" "less -R {path}" "Read a file a page at a time, keeping colours",
    r "hex dump binary file" "xxd {path} | head" "A file's bytes in hex",
    r "strings in binary" "strings {path} | less" "The readable text inside a binary",
    r "csv to json" "python3 -c 'import csv,json,sys; print(json.dumps(list(csv.DictReader(sys.stdin))))' < {path}" "A CSV as a JSON array",
    r "yaml to json" "yq -o=json {path}" "YAML as JSON",
    r "jq pretty print colors" "jq . {path}" "JSON laid out and coloured",
    r "jq array length count items" "jq 'length' {path}" "How many items a JSON array has",
    r "jq filter array select" "jq '.[] | select(.{name} != null)' {path}" "Items of a JSON array that have a field",
    r "jq keys of object" "jq 'keys' {path}" "The keys of a JSON object",
    r "minify json compact" "jq -c . {path}" "JSON on one line",
    r "xml pretty print format" "xmllint --format {path}" "XML laid out to read",

    // Archives and compression.
    r "list contents of tar archive" "tar -tf {path}" "What an archive holds, without unpacking",
    r "extract tar to directory" "tar -xf {path} -C {name}" "Unpack an archive into a directory",
    r "extract tar xz bz2 zst" "tar -xf {path}" "Unpack any tar; tar works out the compression",
    r "compress with zstd fast" "zstd -T0 {path}" "Compress a file with zstd, on every core",
    r "compress xz smallest" "xz -9 -T0 {path}" "Compress a file as small as xz can",
    r "gzip compress file" "gzip -k {path}" "Compress a file, keeping the original",
    r "gunzip decompress gz" "gunzip -k {path}" "Decompress a .gz, keeping it",
    r "list zip contents" "unzip -l {path}" "What a .zip holds",
    r "extract 7z rar" "7z x {path}" "Unpack a .7z, .rar or most anything else",
    r "zip with password encrypt" "zip -er {name}.zip {path}" "A password-protected .zip",
    r "backup directory with date" "tar -czf {name}-$(date +%F).tar.gz {path}" "A dated .tar.gz of a directory",

    // Processes and jobs.
    r "run command in background" "nohup {name} > out.log 2>&1 &" "Run a command that outlives the shell",
    r "list background jobs" "jobs -l" "This shell's background jobs",
    r "bring job to foreground" "fg %1" "Bring the first job back",
    r "detach process disown" "disown -h %1" "Let a job keep running after the shell exits",
    r "process tree" "pstree -p" "Processes as a tree, with ids",
    r "interactive process viewer htop" "htop" "Processes, live, sortable",
    r "what files a process has open" "lsof -p {pid}" "Every file and socket a process holds",
    r "which process has file open locked" "fuser -v {path}" "Who is using a file",
    r "process working directory" "readlink /proc/{pid}/cwd" "Where a process is running",
    r "process command line full" "tr '\\0' ' ' < /proc/{pid}/cmdline" "Exactly how a process was started",
    r "how long process running uptime" "ps -o etime= -p {pid}" "How long a process has run",
    r "renice lower priority process" "renice +10 -p {pid}" "Let a process have less of the CPU",
    r "run with low priority nice" "nice -n 19 {name}" "Run a command without slowing the machine",
    r "limit command time timeout" "timeout {n}s {name}" "Stop a command after n seconds",
    r "trace system calls strace" "strace -f -o trace.txt {name}" "Every system call a command makes",
    r "pause suspend process" "kill -STOP {pid}" "Freeze a process",
    r "resume continue process" "kill -CONT {pid}" "Let a frozen process go on",
    r "kill all processes of user" "pkill -u {user}" "Stop every process a user runs",
    r "zombie processes defunct" "ps aux | awk '$8 ~ /Z/'" "Processes that ended and were never reaped",
    r "load average uptime" "uptime" "How long it has been up, and how busy",
    r "run commands in parallel" "cat list.txt | xargs -P 8 -I{} {name} {}" "Run a command for each line, eight at a time",
    r "repeat command until it succeeds retry" "until {name}; do sleep 1; done" "Try again every second until it works",
    r "run command at time later at" "echo '{name}' | at now + {n} minutes" "Run a command once, later",
    r "sleep wait seconds" "sleep {n}" "Wait n seconds",
    r "notify when command finishes" "{name}; notify-send 'Done' \"exit $?\"" "A desktop notification when it ends",

    // Networking.
    r "is port open on a host reachable connect test" "nc -zv {host} {port}" "Whether a port on a host answers",
    r "listen on port netcat" "nc -l {port}" "Accept a connection and print what arrives",
    r "trace route path to host" "traceroute {host}" "The hops between here and a host",
    r "mtr network diagnostics" "mtr {host}" "Ping and traceroute together, live",
    r "dns lookup all records" "dig {host} ANY" "Every DNS record a name has",
    r "dns mail mx records" "dig +short MX {host}" "Where a domain's mail goes",
    r "reverse dns lookup ip" "dig -x {host} +short" "The name an address resolves to",
    r "whois domain owner" "whois {host}" "Who registered a domain",
    r "routing table default gateway" "ip route" "Where traffic goes",
    r "wifi networks list" "nmcli device wifi list" "Wi-Fi networks in range",
    r "connect to wifi" "nmcli device wifi connect '{name}' --ask" "Join a Wi-Fi network",
    r "network connections established" "ss -tnp state established" "Every open TCP connection, with its process",
    r "bandwidth usage per process" "sudo nethogs" "Which processes are using the network",
    r "download speed test" "curl -o /dev/null -w '%{speed_download}\\n' {host}" "How fast a download runs, in bytes a second",
    r "http status code only" "curl -s -o /dev/null -w '%{http_code}\\n' {host}" "Just the status a URL answers",
    r "time http request latency" "curl -s -o /dev/null -w 'dns %{time_namelookup} connect %{time_connect} total %{time_total}\\n' {host}" "Where a request's time goes",
    r "follow redirects curl" "curl -L {host}" "Fetch a URL, following redirects",
    r "curl with bearer token auth header" "curl -H \"Authorization: Bearer $TOKEN\" {host}" "Fetch with a token",
    r "curl basic auth username password" "curl -u {user} {host}" "Fetch with a user name and password",
    r "upload file http multipart form" "curl -F 'file=@{path}' {host}" "Send a file as a form upload",
    r "download resume continue" "curl -C - -LO {host}" "Pick a download up where it stopped",
    r "download whole website mirror" "wget -mkEpnp {host}" "A local copy of a site",
    r "send http put delete request" "curl -X DELETE {host}" "Send a DELETE",
    r "ssl certificate expiry check" "echo | openssl s_client -connect {host}:443 -servername {host} 2>/dev/null | openssl x509 -noout -dates" "When a site's certificate runs out",
    r "view certificate details file" "openssl x509 -in {path} -noout -text" "What a certificate says",
    r "generate self signed certificate" "openssl req -x509 -newkey rsa:4096 -nodes -keyout key.pem -out cert.pem -days 365 -subj '/CN=localhost'" "A certificate for local testing",
    r "firewall open port ufw" "sudo ufw allow {port}" "Let traffic in on a port",
    r "firewall status rules" "sudo ufw status verbose" "What the firewall allows",
