    r "what does command do explain" "whatis {name}" "A command, in one line",
    r "change default shell" "chsh -s $(command -v zsh)" "Make zsh your login shell",
    r "set timezone" "sudo timedatectl set-timezone {name}" "Change the time zone",
    r "calendar" "cal -3" "This month, the last and the next",
    r "time in another timezone" "TZ='{name}' date" "What time it is somewhere else",
    r "date arithmetic days from now" "date -d '+{n} days'" "The date n days from now",
    r "stopwatch timer" "time read" "Time something: press Enter to stop",
    r "keyboard layout" "setxkbmap -query" "The keyboard layout (X11)",

    // The machine.
    r "battery status level" "upower -i $(upower -e | grep BAT)" "How the battery is doing",
    r "temperature sensors cpu" "sensors" "How hot the machine is",
    r "memory details hardware ram" "sudo dmidecode -t memory" "The memory installed",
    r "usb devices list" "lsusb" "What is plugged in by USB",
    r "pci devices hardware" "lspci" "The machine's cards and controllers",
    r "disk health smart" "sudo smartctl -a /dev/{name}" "A drive's health",
    r "disk speed benchmark write" "dd if=/dev/zero of=test.bin bs=1M count=1024 oflag=direct status=progress && rm test.bin" "How fast this disk writes",
    r "swap usage" "swapon --show" "Swap in use",
    r "os release distribution version" "cat /etc/os-release" "Which system this is",
    r "graphics card driver" "glxinfo -B" "The graphics driver in use",
    r "screen resolution displays" "kscreen-doctor -o" "The displays and their modes (KDE)",
    r "shutdown power off" "systemctl poweroff" "Turn the machine off",
    r "suspend sleep computer" "systemctl suspend" "Suspend the machine",
    r "lock screen" "loginctl lock-session" "Lock the screen",
    r "volume set audio" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 50%" "Set the volume (PipeWire)",
    r "bluetooth connect devices" "bluetoothctl devices" "Bluetooth devices this machine knows",
];

priv let features q = list.append (text.tokens q) (text.char_ngrams 3 q);
priv let index = text.index features (list.map_indexed (fn i rc -> [i, Recipe.ask rc]) recipes);

/// What a question says that a recipe can use.
let slots : :string -> %{:string => :string};
let slots q = {
    let find_one = fn pattern -> match regex.parse_with [:ignore_case] pattern {
        Result.ok(rx) => match regex.groups (regex.find rx q) { () => (), [] => (), gs => list.head gs },
        Result.error(_) => (),
    };
    let size = match find_one "(\\d+)\\s*(k|kb|m|mb|meg|megabytes?|g|gb|gigabytes?)\\b" {
        () => (),
        n => {
            let unit = str.lower (match find_one "\\d+\\s*(k|kb|m|mb|meg|megabytes?|g|gb|gigabytes?)\\b" { () => "m", u => u });
            n + (if str.starts_with "k" unit { "k" } else if str.starts_with "g" unit { "G" } else { "M" })
        },
    };
    let quoted = match find_one "['\"`]([^'\"`]+)['\"`]" { () => (), x => x };
    let ext = match find_one "\\.([a-zA-Z0-9]{1,6})\\b" {
        () => match find_one "\\b(python|rust|javascript|typescript|go|java|markdown|json|yaml|shell|c\\+\\+|html|css)\\b" {
            () => (),
            lang => match str.lower lang { "python" => "py", "rust" => "rs", "javascript" => "js", "typescript" => "ts", "go" => "go",
                "java" => "java", "markdown" => "md", "json" => "json", "yaml" => "yaml", "shell" => "sh", "html" => "html",
                "css" => "css", _ => "cpp" },
        },
        e => e,
    };
    let host = find_one "\\b((?:https?://)?[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+(?:/\\S*)?)";
    let path_word = find_one "((?:\\.{0,2}/|~/)[\\w./-]*)";
    let named = match quoted { () => find_one "(?:named|called|containing|for|branch)\\s+([\\w.@-]+)", x => x };
    let pairs = [
        ["n", find_one "\\b(\\d+)\\b"], ["size", size], ["port", find_one "port\\s*:?\\s*(\\d+)"], ["pid", find_one "(?:pid|process)\\s+(\\d+)"],
        ["name", named], ["ext", ext], ["host", host], ["path", path_word], ["branch", find_one "branch\\s+([\\w./-]+)"],
        ["user", find_one "(?:user|as)\\s+([a-z_][\\w-]*)"],
    ];
    map.from_pairs (list.filter (fn p -> list.nth 1 p != ()) pairs)
};

/// A recipe's command with the question's values put in its holes; a hole
/// left empty keeps a readable placeholder.
let fill : :string -> %{:string => :string} -> :string;
let fill command values = {
    let defaults = %{ "n" => "7", "size" => "100M", "port" => "8080", "pid" => "PID", "name" => "NAME", "ext" => "txt",
        "host" => "example.com", "path" => ".", "branch" => "my-branch", "user" => "$USER" };
    list.fold (fn c key -> str.replace ("{" + key + "}") (values.[key else defaults.[key]]) c) command (map.keys defaults)
};

/// The commands that do what `question` asks, best first:
/// `%{ "command", "note", "score" }`.
let ask : :string -> :integer -> [%{:string => :any}];
let ask question k = {
    let values = slots question;
    // A language named is a kind of file: say so in the words the recipe uses.
    let languages = ["python", "rust", "javascript", "typescript", "java", "markdown", "json", "yaml", "html", "css"];
    let expanded = if list.any (fn w -> list.contains w languages) (text.tokens question) { question + " extension type" } else { question };
    list.map (fn hit -> {
        let rc = list.nth (list.head hit) recipes;
        %{ "command" => fill (Recipe.command rc) values, "note" => Recipe.note rc, "score" => list.nth 1 hit }
    }) (text.search index expanded k)
};

when test {
    import std.test;
    let first = fn q -> (list.head (ask q 1)).["command"];
    let tests = [
        test.case "a size is filled in" $(test.eq! "find . -type f -size +500M -exec ls -lh {} + | sort -k5 -rh | head -20"
            (first "find files bigger than 500 MB")),
        test.case "a port is filled in" $(test.eq! "lsof -i :8080" (first "what is listening on port 8080")),
        test.case "misspelled questions are still understood" $(test.eq! "git reset --soft HEAD~1" (first "undo my lsat comit")),
        test.case "a language is an extension" $(test.eq! "find . -type f -name '*.py'" (first "find all python files")),
        test.case "an empty hole keeps a placeholder" $(test.eq! "git switch -c my-branch" (fill "git switch -c {branch}" %{})),
        test.case "a host and a port both fill one command" $(test.eq! "nc -zv example.org 5432"
            (first "is port 5432 open on example.org")),
        test.case "a system's own words find its package manager" $(test.eq! "nix-shell -p NAME"
            (first "try a package temporarily with nix")),
        test.case "another language's tests are found by name" $(test.eq! "go test ./... -v" (first "run go tests")),
    ];
}
